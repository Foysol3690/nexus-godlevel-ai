confirmationRequired': true,
        'error': 'Deleting a workspace file requires explicit confirmation.',
      };
    }
    try {
      final entity = await _safePath(relativePath);
      if (entity is! File || !await entity.exists()) return {'success': false, 'error': 'Workspace file not found.'};
      final backup = File('${entity.path}.maya_backup');
      await entity.copy(backup.path);
      await entity.delete();
      final success = !await entity.exists() && await backup.exists();
      return {'success': success, 'path': _relative(entity.path), 'rollbackPath': _relative(backup.path), 'verified': success};
    } catch (error) {
      return {'success': false, 'error': 'Filesystem delete failed: $error'};
    }
  }

  Future<FileSystemEntity> _safePath(String relativePath) async {
    final clean = relativePath.trim();
    if (clean.isEmpty) return await workspace();
    if (path.isAbsolute(clean) || clean.contains('\u0000')) throw ArgumentError('Only relative workspace paths are allowed.');
    final root = await workspace();
    final rootPath = path.normalize(path.absolute(root.path));
    final candidatePath = path.normalize(path.absolute(path.join(rootPath, clean)));
    if (candidatePath != rootPath && !candidatePath.startsWith('$rootPath${path.separator}'))
      throw ArgumentError('Path traversal outside the MAYA workspace is blocked.');
    final directory = Directory(candidatePath);
    if (await directory.exists()) return directory;
    return File(candidatePath);
  }

  String _relative(String absolutePath) {
    final rootPath = _workspace?.path ?? '';
    if (rootPath.isEmpty) return absolutePath;
    return path.relative(absolutePath, from: rootPath);
  }
}
