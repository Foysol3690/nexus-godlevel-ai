import 'dart:math';
import 'package:permission_handler/permission_handler.dart';
import 'advanced_device_service.dart';

class SafeAutomationService {
  static _PendingWhatsApp? _pendingWhatsApp;
  static _PendingWhatsAppCall? _pendingWhatsAppCall;
  static _PendingCellularCall? _pendingCellularCall;
  static _PendingGalleryShare? _pendingGalleryShare;
  static _PendingSensitiveText? _pendingSensitiveText;
  static final Random _random = Random.secure();

  static bool get hasPendingWhatsAppCall => _pendingWhatsAppCall != null;
  static bool get hasPendingCellularCall => _pendingCellularCall != null;
  static bool get hasPendingWhatsAppMessage => _pendingWhatsApp != null;
  static bool get hasPendingGalleryShare => _pendingGalleryShare != null;

  static Future<Map<String, dynamic>> prepareWhatsApp({required String recipient, required String message}) async {
    final target = _cleanRecipient(recipient); final body = message.trim();
    if (target.isEmpty || body.isEmpty) return {'success': false, 'error': 'Recipient and message are required.'};
    String? phone; String displayName = target;
    final digits = _normalizeWhatsAppPhone(target);
    if (digits.length >= 7) { phone = digits; } else {
      final permission = await Permission.contacts.request();
      if (!permission.isGranted) return {'success': false, 'error': permission.isPermanentlyDenied ? 'Contacts permission is blocked. Enable it in Android Settings.' : 'Contacts permission is required to resolve a person by name.'};
      final matches = await AdvancedDeviceService.resolveContacts(target);
      if (matches.isEmpty) return {'success': false, 'error': 'No contact matched "$target".'}
      ;if (matches.length > 1) return {'success': false, 'needsChoice': true, 'error': 'More than one contact matched. Ask the user to choose.', 'matches': matches.take(8).toList()};
      final match = matches.first; phone = _normalizeWhatsAppPhone(match['phone']?.toString() ?? ''); displayName = match['name']?.toString() ?? target;
    }
    final resolvedPhone = phone;
    if (resolvedPhone.length < 7) return {'success': false, 'error': 'The resolved phone number is invalid.'};
    final token = '${DateTime.now().millisecondsSinceEpoch.toRadixString(36)}-${_random.nextInt(0xFFFFFF).toRadixString(16).padLeft(6, '0')}';
    _pendingWhatsApp = _PendingWhatsApp(token: token, displayName: displayName, phone: resolvedPhone, message: body, expiresAt: DateTime.now().add(const Duration(minutes: 2)));
    return {'success': false, 'confirmationRequired': true, 'confirmationToken': token, 'recipient': displayName, 'phone': resolvedPhone, 'message': body, 'instruction': 'Read the recipient and complete message aloud, then ask the user to say confirm send.'};
  }

  static Future<Map<String, dynamic>> confirmWhatsApp({String? token}) async {
    final pending = _pendingWhatsApp;
    if (pending == null) return {'success': false, 'error': 'There is no pending WhatsApp message.'};
    if (DateTime.now().isAfter(pending.expiresAt)) { _pendingWhatsApp = null; return {'success': false, 'error': 'The WhatsApp confirmation expired. Prepare it again.'}; }
    if (token != null && token.isNotEmpty && token != pending.token) return {'success': false, 'error': 'Confirmation token does not match the pending message.'};
    final queued = await AdvancedDeviceService.sendWhatsAppMessage(phone: pending.phone, message: pending.message);
    if (queued) _pendingWhatsApp = null;
    return {'success': queued, 'recipient': pending.displayName, 'phone': pending.phone, 'message': pending.message, if (!queued) 'error': 'WhatsApp could not be opened or the Send control was unavailable.'};
  }

  static Future<Map<String, dynamic>> prepareWhatsAppCall({required String recipient, required String callType}) async {
    final target = _cleanRecipient(recipient); final normalizedType = callType.trim().toLowerCase();
    if (target.isEmpty || !const {'audio', 'video'}.contains(normalizedType)) return {'success': false, 'error': 'Recipient and audio/video call type are required.'};
    String? phone; String displayName = target;
    final digits = _normalizeWhatsAppPhone(target);
    if (digits.length >= 7) { phone = digits; } else {
      final permission = await Permission.contacts.request();
      if (!permission.isGranted) return {'success': false, 'error': permission.isPermanentlyDenied ? 'Contacts permission is blocked. Enable it in Android Settings.' : 'Contacts permission is required to resolve a person by name.'};
      final matches = await AdvancedDeviceService.resolveContacts(target);
      if (matches.isEmpty) return {'success': false, 'error': 'No contact matched "$target".'}
      ;if (matches.length > 1) return {'success': false, 'needsChoice': true, 'error': 'More than one contact matched. Ask the user to choose.', 'matches': matches.take(8).toList()};
      final match = matches.first; phone = _normalizeWhatsAppPhone(match['phone']?.toString() ?? ''); displayName = match['name']?.toString() ?? target;
    }
    final resolvedPhone = phone;
    if (resolvedPhone.length < 7) return {'success': false, 'error': 'The resolved phone number is invalid.'};
    final token = '${DateTime.now().millisecondsSinceEpoch.toRadixString(36)}-${_random.nextInt(0xFFFFFF).toRadixString(16).padLeft(6, '0')}';
    _pendingWhatsAppCall = _PendingWhatsAppCall(token: token, displayName: displayName, phone: resolvedPhone, callType: normalizedType, expiresAt: DateTime.now().add(const Duration(minutes: 2)));
    return {'success': false, 'confirmationRequired': true, 'confirmationToken': token, 'recipient': displayName, 'phone': resolvedPhone, 'callType': normalizedType, 'instruction': 'Read back the exact recipient and call type, then ask for immediate explicit confirmation.'};
  }

  static Future<Map<String, dynamic>> confirmWhatsAppCall({String? token}) async {
    final pending = _pendingWhatsAppCall;
    if (pending == null) return {'success': false, 'error': 'There is no pending WhatsApp call.'};
    if (DateTime.now().isAfter(pending.expiresAt)) { _pendingWhatsAppCall = null; return {'success': false, 'error': 'The WhatsApp call confirmation expired. Prepare it again.'}; }
    if (token != null && token.isNotEmpty && token != pending.token) return {'success': false, 'error': 'Confirmation token does not match the pending call.'};
    final queued = await AdvancedDeviceService.startWhatsAppCall(phone: pending.phone, callType: pending.callType);
    if (queued) _pendingWhatsAppCall = null;
    return {'success': queued, 'recipient': pending.displayName, 'phone': pending.phone, 'callType': pending.callType, if (!queued) 'error': 'WhatsApp could not be opened or its call control was unavailable.'};
  }

  static void cancelWhatsAppCall() => _pendingWhatsAppCall = null;
  static void cancelWhatsApp() => _pendingWhatsApp = null;

  static Future<Map<String, dynamic>> prepareCellularCall({required String recipient}) async {
    final resolved = await _resolveRecipient(recipient); if (resolved['success'] != true) return resolved;
    final token = _freshToken();
    _pendingCellularCall = _PendingCellularCall(token: token, displayName: resolved['recipient']!.toString(), phone: resolved['phone']!.toString(), expiresAt: DateTime.now().add(const Duration(minutes: 2)));
    return {'success': false, 'confirmationRequired': true, 'confirmationToken': token, 'recipient': resolved['recipient'], 'phone': resolved['phone'], 'instruction': 'Read back the exact contact and number, then ask for immediate explicit confirmation before placing the cellular call.'};
  }

  static Future<Map<String, dynamic>> confirmCellularCall({String? token}) async {
    final pending = _pendingCellularCall;
    if (pending == null) return {'success': false, 'error': 'There is no pending cellular call.'};
    if (DateTime.now().isAfter(pending.expiresAt)) { _pendingCellularCall = null; return {'success': false, 'error': 'The cellular-call confirmation expired.'}; }
    if (token != null && token.isNotEmpty && token != pending.token) return {'success': false, 'error': 'Confirmation token does not match the pending call.'};
    final permission = await Permission.phone.request();
    if (!permission.isGranted) return {'success': false, 'error': 'Phone permission is required to place the call.'};
    final placed = await AdvancedDeviceService.placeCellularCall(pending.phone);
    if (placed) _pendingCellularCall = null;
    return {'success': placed, 'recipient': pending.displayName, 'phone': pending.phone, if (!placed) 'error': 'Android could not place the cellular call.'};
  }

  static void cancelCellularCall() => _pendingCellularCall = null;

  static Future<Map<String, dynamic>> prepareGalleryWhatsAppShare({required String recipient, required String imageQuery}) async {
    final resolved = await _resolveRecipient(recipient); if (resolved['success'] != true) return resolved;
    var permission = await Permission.photos.request();
    if (!permission.isGranted) permission = await Permission.storage.request();
    if (!permission.isGranted) return {'success': false, 'error': 'Gallery image permission is required.'};
    final query = imageQuery.trim().isEmpty ? 'latest' : imageQuery.trim();
    final images = await AdvancedDeviceService.resolveGalleryImages(query);
    if (images.isEmpty) return {'success': false, 'error': 'No gallery image matched "$query".'}
    ;final image = images.first; final uri = image['uri']?.toString() ?? ''; final name = image['name']?.toString() ?? 'gallery image';
    if (!uri.startsWith('content://media/')) return {'success': false, 'error': 'Android returned an invalid gallery image.'};
    final token = _freshToken();
    _pendingGalleryShare = _PendingGalleryShare(token: token, displayName: resolved['recipient']!.toString(), phone: resolved['phone']!.toString(), imageUri: uri, imageName: name, dateAdded: image['dateAdded'] is num ? (image['dateAdded'] as num).toInt() : 0, expiresAt: DateTime.now().add(const Duration(minutes: 2)));
    return {'success': false, 'confirmationRequired': true, 'confirmationToken': token, 'recipient': resolved['recipient'], 'phone': resolved['phone'], 'imageName': name, 'dateAdded': image['dateAdded'], 'instruction': 'Private photo sharing requires confirmation. Read back the exact recipient and image file name, then ask for immediate explicit confirmation.'};
  }

  static Future<Map<String, dynamic>> confirmGalleryWhatsAppShare({String? token}) async {
    final pending = _pendingGalleryShare;
    if (pending == null) return {'success': false, 'error': 'There is no pending gallery share.'};
    if (DateTime.now().isAfter(pending.expiresAt)) { _pendingGalleryShare = null; return {'success': false, 'error': 'The gallery-share confirmation expired.'}; }
    if (token != null && token.isNotEmpty && token != pending.token) return {'success': false, 'error': 'Confirmation token does not match the pending gallery share.'};
    final sent = await AdvancedDeviceService.shareWhatsAppImage(imageUri: pending.imageUri, recipient: pending.displayName, phone: pending.phone);
    if (sent) _pendingGalleryShare = null;
    return {'success': sent, 'recipient': pending.displayName, 'phone': pending.phone, 'imageName': pending.imageName, if (!sent) 'error': 'WhatsApp did not expose a usable recipient or Send control.'};
  }

  static void cancelGalleryWhatsAppShare() => _pendingGalleryShare = null;

  static Future<Map<String, dynamic>> _resolveRecipient(String value) async {
    final target = _cleanRecipient(value);
    if (target.isEmpty) return {'success': false, 'error': 'Recipient is required.'};
    final digits = _normalizePhone(target);
    if (digits.length >= 7) return {'success': true, 'recipient': target, 'phone': digits};
    final permission = await Permission.contacts.request();
    if (!permission.isGranted) return {'success': false, 'error': 'Contacts permission is required to resolve a person by name.'};
    final matches = await AdvancedDeviceService.resolveContacts(target);
    if (matches.isEmpty) return {'success': false, 'error': 'No contact matched "$target".'}
    ;if (matches.length > 1) return {'success': false, 'needsChoice': true, 'error': 'More than one contact matched. Ask the user to choose.', 'matches': matches.take(8).toList()};
    final match = matches.first; final phone = _normalizePhone(match['phone']?.toString() ?? '');
    if (phone.length < 7) return {'success': false, 'error': 'The resolved phone number is invalid.'};
    return {'success': true, 'recipient': match['name']?.toString() ?? target, 'phone': phone};
  }

  static String _freshToken() => '${DateTime.now().millisecondsSinceEpoch.toRadixString(36)}-${_random.nextInt(0xFFFFFF).toRadixString(16).padLeft(6, '0')}';

  static bool isSensitiveText(String text) {
    final compactDigits = text.replaceAll(RegExp(r'[^0-9]'), ''); final lower = text.toLowerCase();
    final financialWord = RegExp(r'\b(password|passcode|otp|one.time|pin|cvv|cvc|card|account|routing|bank|billing|payment|purchase)\b').hasMatch(lower);
    final possibleCard = compactDigits.length >= 13 && compactDigits.length <= 19;
    final possibleCode = RegExp(r'^\s*\d{3,8}\s*$').hasMatch(text);
    return financialWord || possibleCard || possibleCode;
  }

  static Map<String, dynamic> prepareSensitiveText(String text) {
    final value = text.trim(); if (value.isEmpty) return {'success': false, 'error': 'Text is empty.'};
    final token = '${DateTime.now().millisecondsSinceEpoch.toRadixString(36)}-${_random.nextInt(0xFFFFFF).toRadixString(16).padLeft(6, '0')}';
    _pendingSensitiveText = _PendingSensitiveText(token: token, text: value, expiresAt: DateTime.now().add(const Duration(seconds: 90)));
    return {'success': false, 'confirmationRequired': true, 'confirmationToken': token, 'sensitive': true, 'instruction': 'Sensitive or financial text detected. Do not repeat it aloud. Ask for immediate confirmation to type it into the currently focused field.'};
  }

  static Future<Map<String, dynamic>> confirmSensitiveText([String? token]) async {
    final pending = _pendingSensitiveText;
    if (pending == null) return {'success': false, 'error': 'No sensitive text is pending.'};
    if (DateTime.now().isAfter(pending.expiresAt)) { _pendingSensitiveText = null; return {'success': false, 'error': 'Sensitive-text confirmation expired.'}; }
    if (token != null && token.isNotEmpty && token != pending.token) return {'success': false, 'error': 'Confirmation token does not match.'};
    final success = await AdvancedDeviceService.typeText(pending.text);
    if (success) _pendingSensitiveText = null;
    return {'success': success, 'message': success ? 'Sensitive text entered after confirmation.' : 'No editable field is focused.'};
  }

  static String _cleanRecipient(String value) { var target = value.trim().replaceAll(RegExp(r'\s+'), ' '); target = target.replaceFirst(RegExp(r'^(?:my\s+|contact\s+|contact named\s+|number\s+for\s+)', caseSensitive: false), ''); return target.trim(); }
  static String _normalizeWhatsAppPhone(String value) { var digits = value.replaceAll(RegExp(r'[^0-9]'), ''); if (digits.startsWith('00')) digits = digits.substring(2); if (digits.length == 11 && digits.startsWith('0')) { digits = '880${digits.substring(1)}'; } else if (digits.length == 10 && digits.startsWith('1')) { digits = '880$digits'; } return digits; }
  static String _normalizePhone(String value) => value.replaceAll(RegExp(r'[^0-9]'), '');
}

class _PendingWhatsApp { final String token, displayName, phone, message; final DateTime expiresAt; const _PendingWhatsApp({required this.token, required this.displayName, required this.phone, required this.message, required this.expiresAt}); }
class _PendingWhatsAppCall { final String token, displayName, phone, callType; final DateTime expiresAt; const _PendingWhatsAppCall({required this.token, required this.displayName, required this.phone, required this.callType, required this.expiresAt}); }
class _PendingCellularCall { final String token, displayName, phone; final DateTime expiresAt; const _PendingCellularCall({required this.token, required this.displayName, required this.phone, required this.expiresAt}); }
class _PendingGalleryShare { final String token, displayName, phone, imageUri, imageName; final int dateAdded; final DateTime expiresAt; const _PendingGalleryShare({required this.token, required this.displayName, required this.phone, required this.imageUri, required this.imageName, required this.dateAdded, required this.expiresAt}); }
class _PendingSensitiveText { final String token, text; final DateTime expiresAt; const _PendingSensitiveText({required this.token, required this.text, required this.expiresAt}); }
