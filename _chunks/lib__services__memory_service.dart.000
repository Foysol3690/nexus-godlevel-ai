import 'dart:convert';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import 'memory_database.dart';
import 'omega_vector_memory_service.dart';

class MayaMemory {
  final String id, text, category, source;
  final DateTime createdAt, updatedAt;
  final double importance;
  final List<String> tags;
  final DateTime? expiresAt;
  const MayaMemory({required this.id, required this.text, required this.category, required this.createdAt, required this.updatedAt, required this.source, required this.importance, required this.tags, required this.expiresAt});
  Map<String, dynamic> toJson() => {'id': id, 'text': text, 'category': category, 'createdAt': createdAt.toIso8601String(), 'updatedAt': updatedAt.toIso8601String(), 'source': source, 'importance': importance, 'tags': tags, if (expiresAt != null) 'expiresAt': expiresAt!.toIso8601String()};
  static MayaMemory fromJson(Map<String, dynamic> json) => MayaMemory(id: json['id']?.toString() ?? '', text: json['text']?.toString() ?? '', category: json['category']?.toString() ?? 'general', createdAt: DateTime.tryParse(json['createdAt']?.toString() ?? '') ?? DateTime.now(), updatedAt: DateTime.tryParse(json['updatedAt']?.toString() ?? '') ?? DateTime.tryParse(json['createdAt']?.toString() ?? '') ?? DateTime.now(), source: json['source']?.toString() ?? 'owner', importance: (json['importance'] as num?)?.toDouble() ?? 0.5, tags: (json['tags'] is List) ? (json['tags'] as List).map((tag) => tag.toString()).toList() : const <String>[], expiresAt: DateTime.tryParse(json['expiresAt']?.toString() ?? ''));
}

class MemoryService {
  static const _storage = FlutterSecureStorage(); static const _key = 'maya_v6_memories';
  final MayaMemoryDatabase _database = MayaMemoryDatabase.instance;
  final MayaOmegaVectorMemoryService _vectors = MayaOmegaVectorMemoryService.instance;

  Future<List<MayaMemory>> list() async {
    try { final rows = await _database.list(); if (rows.isNotEmpty) return rows.map(_fromDatabaseRow).toList(); } catch (_) {}
    final raw = await _storage.read(key: _key);
    if (raw == null || raw.isEmpty) return <MayaMemory>[];
    try { final decoded = jsonDecode(raw); if (decoded is! List) return <MayaMemory>[]; final migrated = decoded.whereType<Map>().map((item) => MayaMemory.fromJson(item.map((key, value) => MapEntry(key.toString(), value)))).toList(); if (migrated.isNotEmpty) { try { await _database.replaceAll(migrated.map((item) => item.toJson()).toList()); for (final item in migrated) await _vectors.index(id: item.id, text: item.text, category: item.category); } catch (_) {} } return migrated; } catch (_) { return <MayaMemory>[]; }
  }

  Future<void> remember(String text, {String category = 'general', String source = 'owner', double importance = 0.5, List<String> tags = const <String>[], Duration? ttl}) async {
    final clean = text.trim(); if (clean.isEmpty) return;
    final items = await list(); items.removeWhere((item) => item.text.toLowerCase() == clean.toLowerCase());
    final now = DateTime.now();
    items.insert(0, MayaMemory(id: DateTime.now().microsecondsSinceEpoch.toString(), text: clean, category: category, createdAt: now, updatedAt: now, source: source, importance: importance.clamp(0, 1).toDouble(), tags: tags.map((tag) => tag.trim()).where((tag) => tag.isNotEmpty).toSet().toList(), expiresAt: ttl == null ? null : now.add(ttl)));
    if (items.length > 200) items.removeRange(200, items.length);
    await _write(items);
    try { await _vectors.index(id: items.first.id, text: items.first.text, category: items.first.category); } catch (_) {}
  }

  Future<List<MayaMemory>> search(String query, {String? category, int limit = 20}) async {
    final cleanQuery = query.trim().toLowerCase(); final now = DateTime.now();
    final tokens = cleanQuery.split(RegExp(r'\s+')).where((token) => token.length > 1).toSet();
    final scored = <MapEntry<MayaMemory, int>>[];
    for (final item in await list()) {
      if (item.expiresAt != null && item.expiresAt!.isBefore(now)) continue;
      if (category != null && item.category != category) continue;
      final haystack = '${item.text} ${item.category} ${item.tags.join(' ')}'.toLowerCase();
      var score = 0;
      if (cleanQuery.isNotEmpty && haystack.contains(cleanQuery)) score += 4;
      score += tokens.where((token) => haystack.contains(token)).length;
      if (cleanQuery.isEmpty || score > 0) { score += (item.importance * 2).round(); scored.add(MapEntry(item, score)); }
    }
    scored.sort((a, b) { final byScore = b.value.compareTo(a.value); return byScore != 0 ? byScore : b.key.updatedAt.compareTo(a.key.updatedAt); });
    return scored.take(limit.clamp(1, 100).toInt()).map((entry) => entry.key).toList();
  }

  Future<List<Map<String, dynamic>>> semanticSearch(String query, {String? category, int limit = 20}) => _vectors.search(query, category: category, limit: limit);
  Future<String> promptContext({int limit = 20}) async { final items = (await search('', limit: limit)); if (items.isEmpty) return ''; return 'Private user-approved memories:\n${items.map((item) => '- ${item.text}').join('\n')}'; }

  Future<int> consolidate() async {
    final now = DateTime.now(); final items = await list(); final seen = <String>{}; final retained = <MayaMemory>[];
    for (final item in items) { if (item.expiresAt != null && item.expiresAt!.isBefore(now)) continue; final key = '${item.category}:${item.text.trim().toLowerCase()}'; if (seen.add(key)) retained.add(item); }
    await _write(retained.take(200).toList()); return items.length - retained.length;
  }

  Future<void> forget(String id) async { final items = await list(); items.removeWhere((item) => item.id == id); await _write(items); try { await _vectors.delete(id); } catch (_) {} }
  Future<void> clear() async { try { await _database.clear(); } catch (_) {} try { await _vectors.clear(); } catch (_) {} await _storage.delete(key: _key); }
  Future<void> _write(List<MayaMemory> items) async { final rows = items.map((item) => item.toJson()).toList(); try { await _database.replaceAll(rows); } catch (_) { await _storage.write(key: _key, value: jsonEncode(rows)); } }

  static MayaMemory _fromDatabaseRow(Map<String, dynamic> row) {
    List<dynamic> tags = const <dynamic>[];
    final rawTags = row['tags_json']?.toString();
    if (rawTags != null && rawTags.isNotEmpty) { try { final decoded = jsonDecode(rawTags); if (decoded is List) tags = decoded; } catch (_) {} }
    return MayaMemory(id: row['id']?.toString() ?? '', text: row['text']?.toString() ?? '', category: row['category']?.toString() ?? 'general', createdAt: DateTime.tryParse(row['created_at']?.toString() ?? '') ?? DateTime.now(), updatedAt: DateTime.tryParse(row['updated_at']?.toString() ?? '') ?? DateTime.now(), source: row['source']?.toString() ?? 'owner', importance: (row['importance'] as num?)?.toDouble() ?? 0.5, tags: tags.map((tag) => tag.toString()).toList(), expiresAt: DateTime.tryParse(row['expires_at']?.toString() ?? ''));
  }
}
