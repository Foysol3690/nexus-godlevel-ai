import 'dart:async';
import 'dart:math' as math;
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'jarvis_orb.dart';
import 'god_level_chat_panel.dart';
import 'god_level_dashboard_v2.dart';
import 'maya_vision_screen.dart';
import 'config_screen.dart';
import 'services/voice_service.dart';
import 'services/god_level_ai_service.dart';
import 'services/tts_service.dart';

class JarvisHomeScreen extends StatefulWidget {
  const JarvisHomeScreen({super.key});
  @override
  State<JarvisHomeScreen> createState() => _JarvisHomeScreenState();
}

class _JarvisHomeScreenState extends State<JarvisHomeScreen>
    with TickerProviderStateMixin {
  final VoiceService _voice = VoiceService();
  final GodLevelAIService _ai = GodLevelAIService();
  final TtsService _tts = TtsService();

  late AnimationController _orbPulseCtrl;
  late AnimationController _ringFadeCtrl;
  late AnimationController _breathCtrl;
  late Animation<double> _orbPulse;
  late Animation<double> _ringFade;
  late Animation<double> _breath;

  bool _listening = false;
  bool _thinking = false;
  bool _servicesReady = false;
  double _audioLevel = 0.0;
  String _statusText = 'MAYA NEXØRA';
  String _subStatus = 'Initializing...';
  Timer? _statusTimer;

  @override
  void initState() {
    super.initState();
    _initAnimations();
    _initServices();
  }

  void _initAnimations() {
    _orbPulseCtrl = AnimationController(
        vsync: this, duration: const Duration(seconds: 2))
      ..repeat(reverse: true);
    _orbPulse = Tween<double>(begin: 0.95, end: 1.05).animate(
        CurvedAnimation(parent: _orbPulseCtrl, curve: Curves.easeInOut));

    _ringFadeCtrl = AnimationController(
        vsync: this, duration: const Duration(seconds: 3))
      ..repeat(reverse: true);
    _ringFade = Tween<double>(begin: 0.25, end: 1.0).animate(
        CurvedAnimation(parent: _ringFadeCtrl, curve: Curves.easeInOut));

    _breathCtrl = AnimationController(
        vsync: this, duration: const Duration(seconds: 4))
      ..repeat(reverse: true);
    _breath = Tween<double>(begin: 0.0, end: 1.0).animate(
        CurvedAnimation(parent: _breathCtrl, curve: Curves.easeInOut));
  }

  Future<void> _initServices() async {
    try {
      await _tts.init();
      await _voice.init();
      if (mounted) {
        setState(() {
          _servicesReady = true;
          _statusText = 'MAYA NEXØRA — Online';
          _subStatus = 'All systems operational';
        });
      }
      await Future<void>.delayed(const Duration(seconds: 2));
      if (mounted) {
        setState(() {
          _statusText = 'MAYA NEXØRA';
          _subStatus = 'Tap the orb to speak';
        });
      }
    } catch (_) {
      if (mounted) {
        setState(() {
          _servicesReady = true;
          _subStatus = 'Tap the orb to speak';
        });
      }
    }
  }

  Future<void> _toggleListen() async {
    if (_thinking) return;
    if (_listening) {
      setState(() {
        _listening = false;
        _audioLevel = 0.0;
        _statusText = 'MAYA NEXØRA';
        _subStatus = 'Tap the orb to speak';
      });
      return;
    }
    HapticFeedback.mediumImpact();
    setState(() {
      _listening = true;
      _statusText = 'Listening…';
      _subStatus = 'Speak now — I\'m all ears';
    });

    await _voice.startListening(
      (transcript) async {
        if (!mounted) return;
        setState(() {
          _listening = false;
          _audioLevel = 0.0;
        });
        if (transcript.isEmpty || transcript.startsWith('__')) {
          setState(() {
            _statusText = 'Nothing heard';
            _subStatus = 'Tap to try again';
          });
          _scheduleReset();
          return;
        }
        setState(() {
          _thinking = true;
          _statusText = 'Processing…';
          _subStatus = transcript.length > 80
              ? '${transcript.substring(0, 80)}…'
              : transcript;
        });
        try {
          final response = await _ai.chat(transcript);
          if (!mounted) return;
          final replyText = response.text;
          setState(() {
            _statusText = 'Maya responds';
            _subStatus = replyText.length > 100
                ? '${replyText.substring(0, 100)}…'
                : replyText;
          });
          await _tts.speak(replyText);
        } catch (e) {
          if (mounted) {
            setState(() {
              _statusText = 'Error';
              _subStatus = e.toString().length > 80
                  ? e.toString().substring(0, 80)
                  : e.toString();
            });
          }
        } finally {
          if (mounted) setState(() => _thinking = false);
          _scheduleReset();
        }
      },
      onLevel: (level) {
        if (mounted) setState(() => _audioLevel = level);
      },
    );
  }

  void _scheduleReset() {
    _statusTimer?.cancel();
    _statusTimer = Timer(const Duration(seconds: 5), () {
      if (mounted) {
        setState(() {
          _statusText = 'MAYA NEXØRA';
          _subStatus = 'Tap the orb to speak';
        });
      }
    });
  }

  void _openChat() => Navigator.push(
      context, MaterialPageRoute(builder: (_) => const GodLevelChatPanel()));

  void _openDashboard() => Navigator.push(
      context, MaterialPageRoute(builder: (_) => const GodLevelDashboardV2()));

  void _openVision() => Navigator.push(
      context, MaterialPageRoute(builder: (_) => const MayaVisionScreen()));

  void _openSettings() => Navigator.push(
      context,
      MaterialPageRoute(
          builder: (_) => ConfigScreen(onConfigComplete: () {})));

  @override
  void dispose() {
    _orbPulseCtrl.dispose();
    _ringFadeCtrl.dispose();
    _breathCtrl.dispose();
    _statusTimer?.cancel();
    _tts.stop();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final size = MediaQuery.of(context).size;
    return Scaffold(
      backgroundColor: const Color(0xFF02050A),
      body: Stack(
        children: [
          // Deep space gradient background
          Container(
            decoration: const BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topCenter,
                end: Alignment.bottomCenter,
                colors: [
                  Color(0xFF050B1C),
                  Color(0xFF030713),
                  Color(0xFF01030A),
                ],
                stops: [0, 0.55, 1],
              ),
            ),
          ),
          SafeArea(
            child: Column(
              children: [
                _buildTopBar(),
                Expanded(
                  child: Stack(
                    alignment: Alignment.center,
                    children: [
                      // Breathing glow behind orb
                      AnimatedBuilder(
                        animation: _breath,
                        builder: (_, __) => Container(
                          width: size.width * 0.72,
                          height: size.width * 0.72,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            boxShadow: [
                              BoxShadow(
                                color: (_listening
                                        ? const Color(0xFF00FF88)
                                        : const Color(0xFF00D9FF))
                                    .withOpacity(
                                        0.06 + _breath.value * 0.10),
                                blurRadius: 80,
                                spreadRadius: 20,
                              ),
                            ],
                          ),
                        ),
                      ),
                      // Animated fade rings
                      AnimatedBuilder(
                        animation: _ringFade,
                        builder: (_, __) => _GlowRings(
                          fadeValue: _ringFade.value,
                          listening: _listening,
                          thinking: _thinking,
                        ),
                      ),
                      // Orb — core UI element
                      AnimatedBuilder(
                        animation: _orbPulse,
                        builder: (_, __) => Transform.scale(
                          scale: _listening
                              ? 1.0 + _audioLevel * 0.08
                              : _orbPulse.value,
                          child: GestureDetector(
                            onTap: _toggleListen,
                            onLongPress: _openChat,
                            child: JarvisOrb(
                              size: math.min(size.width * 0.55, 260),
                              listening: _listening,
                              audioLevel: _audioLevel,
                              primaryColor: _listening
                                  ? const Color(0xFF00FF88)
                                  : _thinking
                                      ? const Color(0xFFFF7A18)
                                      : const Color(0xFF00D9FF),
                              coreColor: const Color(0xFFBEF0FF),
                              centerLabel: _listening
                                  ? 'LISTENING'
                                  : _thinking
                                      ? 'THINKING'
                                      : null,
                            ),
                          ),
                        ),
                      ),
                      // Status text
                      Positioned(
                        bottom: 24,
                        left: 24,
                        right: 24,
                        child: _buildStatusText(),
                      ),
                    ],
                  ),
                ),
                _buildBottomBar(),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTopBar() => Padding(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
        child: Row(
          children: [
            const Text(
              'MAYA NEXØRA',
              style: TextStyle(
                  color: Color(0xFF00D9FF),
                  fontSize: 13,
                  fontWeight: FontWeight.w700,
                  letterSpacing: 2.5),
            ),
            const Spacer(),
            if (!_servicesReady)
              const Padding(
                padding: EdgeInsets.only(right: 8),
                child: SizedBox(
                    width: 14,
                    height: 14,
                    child: CircularProgressIndicator(
                        color: Color(0xFF00D9FF), strokeWidth: 1.5)),
              ),
            _topBtn(Icons.remove_red_eye_outlined, _openVision),
            _topBtn(Icons.dashboard_outlined, _openDashboard),
            _topBtn(Icons.settings_outlined, _openSettings),
          ],
        ),
      );

  Widget _topBtn(IconData icon, VoidCallback onTap) => IconButton(
        icon: Icon(icon, color: Colors.white54, size: 20),
        onPressed: onTap,
        constraints: const BoxConstraints(minWidth: 36, minHeight: 36),
        padding: const EdgeInsets.all(6),
      );

  Widget _buildStatusText() => Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          AnimatedSwitcher(
            duration: const Duration(milliseconds: 350),
            child: Text(
              _statusText,
              key: ValueKey(_statusText),
              textAlign: TextAlign.center,
              style: const TextStyle(
                  color: Colors.white,
                  fontSize: 15,
                  fontWeight: FontWeight.w600,
                  letterSpacing: 0.5),
            ),
          ),
          const SizedBox(height: 4),
          AnimatedSwitcher(
            duration: const Duration(milliseconds: 350),
            child: Text(
              _subStatus,
              key: ValueKey(_subStatus),
              textAlign: TextAlign.center,
              style:
                  const TextStyle(color: Colors.white54, fontSize: 12),
            ),
          ),
        ],
      );

  Widget _buildBottomBar() => Container(
        margin: const EdgeInsets.fromLTRB(16, 4, 16, 20),
        padding:
            const EdgeInsets.symmetric(horizontal: 8, vertical: 12),
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(24),
          color: Colors.white.withOpacity(0.05),
          border:
              Border.all(color: Colors.white.withOpacity(0.08)),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          children: [
            _actionBtn(
              _listening
                  ? Icons.stop_rounded
                  : Icons.mic_none_rounded,
              _listening ? 'Stop' : 'Speak',
              _toggleListen,
              _listening
                  ? const Color(0xFF00FF88)
                  : const Color(0xFF00D9FF),
            ),
            _actionBtn(Icons.chat_bubble_outline_rounded, 'Chat',
                _openChat, const Color(0xFF00D9FF)),
            _actionBtn(Icons.auto_awesome, 'God Mode', _openDashboard,
                const Color(0xFFFF7A18)),
            _actionBtn(Icons.remove_red_eye_outlined, 'Vision',
                _openVision, const Color(0xFF9B59B6)),
            _actionBtn(Icons.settings_outlined, 'Settings',
                _openSettings, Colors.white54),
          ],
        ),
      );

  Widget _actionBtn(
          IconData icon, String label, VoidCallback onTap, Color color) =>
      GestureDetector(
        onTap: onTap,
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 6),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Icon(icon, color: color, size: 22),
              const SizedBox(height: 3),
              Text(
                label,
                style: TextStyle(
                    color: color.withOpacity(0.85),
                    fontSize: 10,
                    fontWeight: FontWeight.w500),
              ),
            ],
          ),
        ),
      );
}

// ─── Glassmorphic Fade Rings ──────────────────────────────────────────────────────
class _GlowRings extends StatelessWidget {
  final double fadeValue;
  final bool listening;
  final bool thinking;
  const _GlowRings(
      {required this.fadeValue,
      required this.listening,
      required this.thinking});

  @override
  Widget build(BuildContext context) {
    final color = listening
        ? const Color(0xFF00FF88)
        : thinking
            ? const Color(0xFFFF7A18)
            : const Color(0xFF00D9FF);
    return Stack(
      alignment: Alignment.center,
      children: [
        for (int i = 0; i < 4; i++)
          Opacity(
            opacity: (fadeValue * (1.0 - i * 0.20)).clamp(0.0, 1.0),
            child: Container(
              width: 230.0 + i * 38.0,
              height: 230.0 + i * 38.0,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                border: Border.all(
                  color: color
                      .withOpacity((0.55 - i * 0.10).clamp(0.0, 1.0)),
                  width: (2.5 - i * 0.5).clamp(0.4, 2.5),
                ),
                boxShadow: [
                  BoxShadow(
                    color: color.withOpacity(0.10 - i * 0.02),
                    blurRadius: 18.0 + i * 8,
                    spreadRadius: 2,
                  ),
                ],
              ),
            ),
          ),
      ],
    );
  }
}
