import 'dart:async';
import 'dart:math' as math;
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'services/god_level_ai_service.dart';
import 'services/auto_agent_service.dart';
import 'services/emotion_engine_service.dart';
import 'god_level_chat_panel.dart';
import 'config_screen.dart';
import 'maya_vision_screen.dart';
import 'services/advanced_device_service.dart';
import 'services/telegram_service.dart';

class GodLevelDashboardV2 extends StatefulWidget {
  const GodLevelDashboardV2({super.key});
  @override State<GodLevelDashboardV2> createState() => _GodLevelDashboardV2State();
}

class _GodLevelDashboardV2State extends State<GodLevelDashboardV2> with SingleTickerProviderStateMixin {
  static const _bg = Color(0xFF03030A), _surface = Color(0xFF090912), _cyan = Color(0xFF00D9FF), _violet = Color(0xFFAA00FF), _pink = Color(0xFFFF3CAC), _green = Color(0xFF00FF87), _orange = Color(0xFFFF8A24);
  final _ai = GodLevelAIService(), _agent = AutoAgentService(), _emotion = EmotionEngineService();
  late final AnimationController _pulse;
  Timer? _statTimer;
  int _uptimeSeconds = 0, _selectedTab = 0;

  @override
  void initState() {
    super.initState();
    _pulse = AnimationController(vsync: this, duration: const Duration(seconds: 3))..repeat();
    _ai.addListener(_refresh); _agent.addListener(_refresh);
    _statTimer = Timer.periodic(const Duration(seconds: 1), (_) { if (mounted) setState(() => _uptimeSeconds++); });
  }

  void _refresh() { if (mounted) setState(() {}); }

  @override
  void dispose() { _pulse.dispose(); _statTimer?.cancel(); _ai.removeListener(_refresh); _agent.removeListener(_refresh); super.dispose(); }

  @override
  Widget build(BuildContext context) {
    return Scaffold(backgroundColor: _bg, body: CustomScrollView(slivers: [
      _buildAppBar(), SliverToBoxAdapter(child: _statusBar()), SliverToBoxAdapter(child: _heroCard()),
      SliverToBoxAdapter(child: _quickActions()), SliverToBoxAdapter(child: _modelGrid()),
      SliverToBoxAdapter(child: _statsRow()),
      if (_agent.currentPlan != null) SliverToBoxAdapter(child: _agentCard()),
      SliverToBoxAdapter(child: _recentConversations()), SliverToBoxAdapter(child: _emotionTimeline()),
      const SliverToBoxAdapter(child: SizedBox(height: 80)),
    ]), floatingActionButton: _godLevelChatFab());
  }

  Widget _buildAppBar() => SliverAppBar(backgroundColor: _surface, expandedHeight: 140, pinned: true, flexibleSpace: FlexibleSpaceBar(background: Container(decoration: const BoxDecoration(gradient: LinearGradient(begin: Alignment.topLeft, end: Alignment.bottomRight, colors: [Color(0xFF0A0E20), Color(0xFF12091D)])), child: Padding(padding: const EdgeInsets.fromLTRB(20, 60, 20, 12), child: Row(crossAxisAlignment: CrossAxisAlignment.center, children: [
    AnimatedBuilder(animation: _pulse, builder: (_, __) { final glow = 0.5 + math.sin(_pulse.value * 2 * math.pi) * 0.5; return Container(width: 48, height: 48, decoration: BoxDecoration(shape: BoxShape.circle, gradient: const RadialGradient(colors: [Color(0xFF00D9FF), Color(0xFF0A0E20)]), boxShadow: [BoxShadow(color: _cyan.withOpacity(glow * 0.6), blurRadius: 16 + glow * 12, spreadRadius: glow * 4)]), child: const Icon(Icons.auto_awesome, color: Colors.white, size: 22)); }),
    const SizedBox(width: 14),
    Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, mainAxisAlignment: MainAxisAlignment.center, children: [const Text('MAYA GOD MODE', style: TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.w900, letterSpacing: 1.5)), Text('Supreme Intelligence Core · v10.0', style: TextStyle(color: _cyan.withOpacity(0.8), fontSize: 12))])),
    IconButton(icon: const Icon(Icons.settings_outlined, color: Colors.white54), onPressed: _openSettings),
  ]))));

  Widget _statusBar() => Container(color: _surface, padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8), child: Row(children: [_statusDot(_ai.isThinking ? _cyan : _green, _ai.isThinking ? 'THINKING' : 'READY'), const Spacer(), _statusPill(_formatUptime(_uptimeSeconds), Icons.timer_outlined, Colors.white38), const SizedBox(width: 8), _statusPill('${_ai.totalTokensUsed}tk', Icons.toll_outlined, _violet.withOpacity(0.7))]));

  Widget _statusDot(Color color, String label) => Row(mainAxisSize: MainAxisSize.min, children: [AnimatedBuilder(animation: _pulse, builder: (_, __) { final s = 1.0 + math.sin(_pulse.value * 2 * math.pi) * 0.2; return Transform.scale(scale: s, child: Container(width: 8, height: 8, decoration: BoxDecoration(shape: BoxShape.circle, color: color, boxShadow: [BoxShadow(color: color.withOpacity(0.6), blurRadius: 6)]))); }), const SizedBox(width: 6), Text(label, style: TextStyle(color: color, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1))]);
  Widget _statusPill(String text, IconData icon, Color color) => Container(padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4), decoration: BoxDecoration(borderRadius: BorderRadius.circular(20), color: color.withOpacity(0.1), border: Border.all(color: color.withOpacity(0.3))), child: Row(mainAxisSize: MainAxisSize.min, children: [Icon(icon, size: 11, color: color), const SizedBox(width: 4), Text(text, style: TextStyle(color: color, fontSize: 11, fontWeight: FontWeight.bold))]));

  Widget _heroCard() => Container(margin: const EdgeInsets.all(16), padding: const EdgeInsets.all(20), decoration: BoxDecoration(borderRadius: BorderRadius.circular(16), gradient: const LinearGradient(colors: [Color(0xFF0D1629), Color(0xFF14092A)], begin: Alignment.topLeft, end: Alignment.bottomRight), border: Border.all(color: _cyan.withOpacity(0.25)), boxShadow: [BoxShadow(color: _cyan.withOpacity(0.08), blurRadius: 20, spreadRadius: 2)]), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
    Row(children: [ShaderMask(shaderCallback: (b) => const LinearGradient(colors: [Color(0xFF00D9FF), Color(0xFFAA00FF), Color(0xFFFF3CAC)]).createShader(b), child: const Text('GOD-LEVEL AI ACTIVE', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.w900, letterSpacing: 1))), const Spacer(), if (_ai.lastDetectedEmotion != UserEmotion.neutral) Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4), decoration: BoxDecoration(borderRadius: BorderRadius.circular(12), color: Colors.white.withOpacity(0.08)), child: Text(_emotionLabel(_ai.lastDetectedEmotion), style: const TextStyle(fontSize: 12, color: Colors.white70)))]),
    const SizedBox(height: 10),
    Text('Multi-model AI · Chain-of-Thought Reasoning · Autonomous Agent · Emotion Intelligence · Self-Critique · Streaming', style: TextStyle(color: Colors.white.withOpacity(0.55), height: 1.5, fontSize: 12)),
    const SizedBox(height: 16), _capabilityChips(),
  ]));

  Widget _capabilityChips() => const Wrap(spacing: 8, runSpacing: 8, children: [_CapChip('🧠 Chain-of-Thought'), _CapChip('🌌 Quantum Reasoning'), _CapChip('🤖 Autonomous Agent'), _CapChip('😊 Emotion AI'), _CapChip('🔄 Self-Critique'), _CapChip('⚡ Multi-Model'), _CapChip('💬 Streaming'), _CapChip('🎯 Smart Routing')]);

  Widget _quickActions() => Padding(padding: const EdgeInsets.symmetric(horizontal: 16), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
    _sectionHeader('QUICK ACTIONS', _pink), const SizedBox(height: 12),
    GridView.count(crossAxisCount: 3, shrinkWrap: true, physics: const NeverScrollableScrollPhysics(), crossAxisSpacing: 10, mainAxisSpacing: 10, childAspectRatio: 1.1, children: [
      _actionTile('💬', 'God Chat', _cyan, _openGodChat), _actionTile('🌌', 'Quantum', _violet, () => _openChatWithMode(ReasoningMode.quantum)), _actionTile('🤖', 'Agent', _pink, () => _openChatWithMode(ReasoningMode.autonomous)),
      _actionTile('👁', 'Vision', _orange, _openVision), _actionTile('🔑', 'Providers', Colors.white54, _openSettings), _actionTile('📡', 'Telegram', Colors.blue, _testTelegram),
    ]),
  ]));

  Widget _actionTile(String emoji, String label, Color color, VoidCallback onTap) => GestureDetector(onTap: onTap, child: Container(decoration: BoxDecoration(borderRadius: BorderRadius.circular(14), color: color.withOpacity(0.08), border: Border.all(color: color.withOpacity(0.25))), child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [Text(emoji, style: const TextStyle(fontSize: 24)), const SizedBox(height: 6), Text(label, style: TextStyle(color: color, fontSize: 11, fontWeight: FontWeight.bold))])));

  Widget _modelGrid() => Padding(padding: const EdgeInsets.fromLTRB(16, 20, 16, 0), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
    _sectionHeader('AI MODEL ROSTER', _violet), const SizedBox(height: 12),
    GridView.builder(gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount: 2, childAspectRatio: 2.8, crossAxisSpacing: 10, mainAxisSpacing: 10), shrinkWrap: true, physics: const NeverScrollableScrollPhysics(), itemCount: _models.length, itemBuilder: (_, i) => _modelTile(_models[i])),
  ]));

  Widget _modelTile(_ModelEntry m) {
    final count = _ai.modelUsageCounts[m.model] ?? 0; final isActive = _ai.activeModel == m.model || (_ai.activeModel == GodLevelModel.auto && count > 0);
    return GestureDetector(onTap: () { setState(() => _ai.setModel(m.model)); HapticFeedback.lightImpact(); }, child: Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6), decoration: BoxDecoration(borderRadius: BorderRadius.circular(10), color: isActive ? m.color.withOpacity(0.12) : Colors.white.withOpacity(0.04), border: Border.all(color: isActive ? m.color.withOpacity(0.5) : Colors.white.withOpacity(0.08))), child: Row(children: [Text(m.icon, style: const TextStyle(fontSize: 18)), const SizedBox(width: 8), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, mainAxisAlignment: MainAxisAlignment.center, children: [Text(m.name, style: TextStyle(color: isActive ? m.color : Colors.white60, fontSize: 11, fontWeight: FontWeight.bold), overflow: TextOverflow.ellipsis), if (count > 0) Text('$count uses', style: const TextStyle(color: Colors.white24, fontSize: 9))])), if (isActive) Container(width: 6, height: 6, decoration: BoxDecoration(shape: BoxShape.circle, color: m.color, boxShadow: [BoxShadow(color: m.color.withOpacity(0.7), blurRadius: 4)]))])));
  }

  Widget _statsRow() => Padding(padding: const EdgeInsets.fromLTRB(16, 20, 16, 0), child: Row(children: [Expanded(child: _statCard('Conversations', '${_ai.conversation.length ~/ 2}', Icons.chat_bubble_outline, _cyan)), const SizedBox(width: 10), Expanded(child: _statCard('Tokens Used', _formatTokensBig(_ai.totalTokensUsed), Icons.toll_outlined, _violet)), const SizedBox(width: 10), Expanded(child: _statCard('Uptime', _formatUptime(_uptimeSeconds), Icons.timer_outlined, _green))]));
  Widget _statCard(String label, String value, IconData icon, Color color) => Container(padding: const EdgeInsets.all(12), decoration: BoxDecoration(borderRadius: BorderRadius.circular(12), color: color.withOpacity(0.07), border: Border.all(color: color.withOpacity(0.2))), child: Column(children: [Icon(icon, color: color, size: 18), const SizedBox(height: 6), Text(value, style: TextStyle(color: color, fontSize: 16, fontWeight: FontWeight.w900)), Text(label, style: const TextStyle(color: Colors.white38, fontSize: 9), textAlign: TextAlign.center)]));

  Widget _agentCard() { final plan = _agent.currentPlan!; return Container(margin: const EdgeInsets.fromLTRB(16, 20, 16, 0), padding: const EdgeInsets.all(16), decoration: BoxDecoration(borderRadius: BorderRadius.circular(14), gradient: LinearGradient(colors: [_pink.withOpacity(0.08), Colors.transparent], begin: Alignment.topLeft, end: Alignment.bottomRight), border: Border.all(color: _pink.withOpacity(0.3))), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Row(children: [Icon(Icons.smart_toy_outlined, color: _pink, size: 16), const SizedBox(width: 8), Expanded(child: Text('ACTIVE AGENT TASK', style: TextStyle(color: _pink, fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1))), Text('${(plan.progress * 100).round()}%', style: TextStyle(color: _pink, fontWeight: FontWeight.bold))]), const SizedBox(height: 8), Text(plan.goal, style: const TextStyle(color: Colors.white70, fontSize: 13)), const SizedBox(height: 8), ClipRRect(borderRadius: BorderRadius.circular(4), child: LinearProgressIndicator(value: plan.progress, backgroundColor: Colors.white12, valueColor: AlwaysStoppedAnimation<Color>(_pink), minHeight: 4)), const SizedBox(height: 6), Text(_agent.statusMessage, style: const TextStyle(color: Colors.white38, fontSize: 11))])); }

  Widget _recentConversations() { if (_ai.conversation.isEmpty) return const SizedBox.shrink(); final recent = _ai.conversation.reversed.take(6).toList(); return Padding(padding: const EdgeInsets.fromLTRB(16, 20, 16, 0), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [_sectionHeader('RECENT MESSAGES', _cyan), const SizedBox(height: 12), ...recent.map((msg) => _recentMsgTile(msg))])); }
  Widget _recentMsgTile(ConversationMessage msg) { final isUser = msg.role == 'user'; return GestureDetector(onTap: _openGodChat, child: Container(margin: const EdgeInsets.only(bottom: 8), padding: const EdgeInsets.all(12), decoration: BoxDecoration(borderRadius: BorderRadius.circular(10), color: Colors.white.withOpacity(0.04), border: Border.all(color: Colors.white.withOpacity(0.06))), child: Row(children: [Icon(isUser ? Icons.person_outline : Icons.auto_awesome, size: 14, color: isUser ? Colors.white38 : _cyan), const SizedBox(width: 8), Expanded(child: Text(msg.content.length > 80 ? msg.content.substring(0, 80) + '...' : msg.content, style: TextStyle(color: isUser ? Colors.white60 : Colors.white70, fontSize: 12))), const Icon(Icons.chevron_right, size: 14, color: Colors.white24)]))); }

  Widget _emotionTimeline() { final history = _emotion.emotionHistory.takeLast(20); if (history.isEmpty) return const SizedBox.shrink(); return Padding(padding: const EdgeInsets.fromLTRB(16, 20, 16, 0), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [_sectionHeader('EMOTION TIMELINE', _orange), const SizedBox(height: 12), SizedBox(height: 60, child: Row(crossAxisAlignment: CrossAxisAlignment.end, children: history.map((e) { final height = ((e.valence + 1) / 2 * 50 + 10).clamp(10.0, 60.0); final color = e.valence > 0.2 ? _green : e.valence < -0.2 ? const Color(0xFFFF3CAC) : Colors.white24; return Expanded(child: Padding(padding: const EdgeInsets.symmetric(horizontal: 1), child: Tooltip(message: e.primaryLabel, child: AnimatedContainer(duration: const Duration(milliseconds: 300), height: height, decoration: BoxDecoration(borderRadius: BorderRadius.circular(3), color: color.withOpacity(0.7)))))); }).toList())), const SizedBox(height: 6), Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [Text('Negative', style: TextStyle(color: _pink.withOpacity(0.6), fontSize: 10)), const Text('Emotion Valence', style: TextStyle(color: Colors.white24, fontSize: 10)), Text('Positive', style: TextStyle(color: _green.withOpacity(0.6), fontSize: 10))])])); }

  Widget _godLevelChatFab() => FloatingActionButton.extended(onPressed: _openGodChat, backgroundColor: const Color(0xFF0D1629), elevation: 8, icon: ShaderMask(shaderCallback: (b) => const LinearGradient(colors: [Color(0xFF00D9FF), Color(0xFFAA00FF)]).createShader(b), child: const Icon(Icons.auto_awesome, color: Colors.white)), label: ShaderMask(shaderCallback: (b) => const LinearGradient(colors: [Color(0xFF00D9FF), Color(0xFFAA00FF)]).createShader(b), child: const Text('GOD CHAT', style: TextStyle(color: Colors.white, fontWeight: FontWeight.w900, letterSpacing: 1))));
  Widget _sectionHeader(String title, Color color) => Row(children: [Container(width: 3, height: 14, color: color, margin: const EdgeInsets.only(right: 8)), Text(title, style: TextStyle(color: color.withOpacity(0.9), fontSize: 11, fontWeight: FontWeight.bold, letterSpacing: 1.5))]);

  void _openGodChat() => Navigator.of(context).push(MaterialPageRoute(builder: (_) => const GodLevelChatPanel()));
  void _openChatWithMode(ReasoningMode mode) { _ai.setReasoningMode(mode); _openGodChat(); }
  void _openVision() => Navigator.of(context).push(MaterialPageRoute(builder: (_) => const MayaVisionScreen()));
  void _openSettings() => Navigator.of(context).push(MaterialPageRoute(builder: (_) => ConfigScreen(onConfigComplete: () => Navigator.pop(context))));
  Future<void> _testTelegram() async { final bot = TelegramService(); final ready = await bot.restart(); if (!mounted) return; ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(ready ? 'Telegram connected: ${bot.status}' : bot.status))); }

  String _formatUptime(int seconds) { final h = seconds ~/ 3600; final m = (seconds % 3600) ~/ 60; final s = seconds % 60; if (h > 0) return '${h}h ${m}m'; if (m > 0) return '${m}m ${s}s'; return '${s}s'; }
  String _formatTokensBig(int t) { if (t > 1000000) return '${(t / 1000000).toStringAsFixed(1)}M'; if (t > 1000) return '${(t / 1000).toStringAsFixed(1)}k'; return t.toString(); }
  String _emotionLabel(UserEmotion e) => switch (e) { UserEmotion.happy => '😄 Happy', UserEmotion.frustrated => '😤 Frustrated', UserEmotion.anxious => '😰 Anxious', UserEmotion.curious => '🤔 Curious', UserEmotion.urgent => '⚡ Urgent', UserEmotion.neutral => '' };

  static const _models = [_ModelEntry('🌌', 'Gemini 1.5 Pro', GodLevelModel.gemini15Pro, Color(0xFF00D9FF)), _ModelEntry('⚡', 'Gemini 2.0 Flash', GodLevelModel.gemini20Flash, Color(0xFF00FF87)), _ModelEntry('🌟', 'Gemini 3.1 Pro', GodLevelModel.gemini31Pro, Color(0xFF00BFA5)), _ModelEntry('⚡⚡', 'Gemini 3.8 Flash', GodLevelModel.gemini38Flash, Color(0xFF69F0AE)), _ModelEntry('🧠', 'GPT-4o', GodLevelModel.gpt4o, Color(0xFF10A37F)), _ModelEntry('💜', 'Claude 3.5', GodLevelModel.claude35Sonnet, Color(0xFFAA00FF)), _ModelEntry('🔥', 'Groq Llama3', GodLevelModel.groqLlama3, Color(0xFFFF8A24)), _ModelEntry('🌀', 'Mistral Large', GodLevelModel.mistralLarge, Color(0xFF7B61FF)), _ModelEntry('🎯', 'Auto Router', GodLevelModel.auto, Color(0xFFFF3CAC))];
}

class _ModelEntry { final String icon, name; final GodLevelModel model; final Color color; const _ModelEntry(this.icon, this.name, this.model, this.color); }
class _CapChip extends StatelessWidget { final String label; const _CapChip(this.label); @override Widget build(BuildContext context) => Container(padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5), decoration: BoxDecoration(borderRadius: BorderRadius.circular(20), color: Colors.white.withOpacity(0.06), border: Border.all(color: Colors.white12)), child: Text(label, style: const TextStyle(color: Colors.white60, fontSize: 11))); }
extension ListTakeLastDash<T> on List<T> { List<T> takeLast(int n) => length <= n ? this : sublist(length - n); }
