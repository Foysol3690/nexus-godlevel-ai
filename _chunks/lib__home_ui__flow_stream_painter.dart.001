
    final sparkColors = [const Color(0xFF7DD3FC), const Color(0xFFFDBA74), const Color(0xFFC4B5FD), const Color(0xFF67E8F9), const Color(0xFFFB7185), const Color(0xFFE0F2FE)];
    for (var i = 0; i < 14; i++) {
      final u = ((t * (3 + i % 3)) + i / 14) % 1.0;
      if (u < 0.2) continue;
      final tan = metric.getTangentForOffset(length * u)!;
      final normal = Offset(-tan.vector.dy, tan.vector.dx);
      final jitter = math.sin(i * 12.9898 + phaseT) * unit * 9 * math.sin(math.pi * u);
      final pos = tan.position + normal * jitter;
      final r = unit * (0.9 + (i % 3) * 0.5) * (1 + level);
      final fade = math.min(1.0, (u - 0.2) / 0.15) * (1 - u * 0.4);
      canvas.drawCircle(pos, r * 2.4, Paint()..color = sparkColors[i % sparkColors.length].withValues(alpha: 0.35 * fade)..maskFilter = MaskFilter.blur(BlurStyle.normal, r * 2));
      canvas.drawCircle(pos, r, Paint()..color = sparkColors[i % sparkColors.length].withValues(alpha: fade));
    }
    final junction = micTop + Offset(0, micRadius * 0.05);
    canvas.drawCircle(junction, micRadius * (0.32 + energy * 0.15), Paint()..shader = RadialGradient(colors: [const Color(0xFFBAE6FD).withValues(alpha: 0.55 * energy), const Color(0xFF38BDF8).withValues(alpha: 0.2 * energy), const Color(0x0038BDF8)]).createShader(Rect.fromCircle(center: junction, radius: micRadius * 0.5)));
  }

  @override
  bool shouldRepaint(FlowStreamPainter old) => old.t != t || old.level != level || old.active != active || old.micTop != micTop || old.tail.first != tail.first;
}
