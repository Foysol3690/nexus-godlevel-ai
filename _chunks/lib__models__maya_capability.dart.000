enum CapabilityState { ready, permission, setup, companion, planned }

class MayaCapability {
  final String title, description, category;
  final CapabilityState state;
  final String? settingsKey;
  const MayaCapability({required this.title, required this.description, required this.category, required this.state, this.settingsKey});
}

