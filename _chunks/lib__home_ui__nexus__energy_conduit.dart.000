import 'dart:math' as math;

import 'package:flutter/foundation.dart';
import 'package:flutter/rendering.dart';

import 'audio_visual_state.dart';
import 'glow_mesh.dart';
import 'nexus_layout.dart';
import 'nexus_palette.dart';

/// The curved energy channel linking the microphone and the orb core.
class ConduitGeometry {
  ConduitGeometry(NexusLayout layout, AudioVisualState s, {double strand = 0}) {
    final mic = Offset(layout.micCenter.dx, layout.micCenter.dy - layout.micRadius * 1.02);
    final core = layout.orbCenter;
    final r = layout.orbRadius;
    final sway = flowNoise(strand * 1.7 + .3, s.time * .55) * (6 + s.mid * 16) + strand * 7;
    final sway2 = flowNoise(strand * 2.3 + 4.1, s.time * .43) * (8 + s.mid * 20) - strand * 9;
    final span = mic.dy - core.dy;
    _p0 = mic;
    _p1 = Offset(mic.dx + r * .38 + sway, mic.dy - span * .42);
    _p2 = Offset(core.dx - r * .78 + sway2, core.dy + r * .95);
    _p3 = core;
  }

  late final Offset _p0, _p1, _p2, _p3;

  Offset at(double t) {
    final u = 1 - t;
    final a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
    return Offset(a * _p0.dx + b * _p1.dx + c * _p2.dx + d * _p3.dx, a * _p0.dy + b * _p1.dy + c * _p2.dy + d * _p3.dy);
  }

  Offset normalAt(double t) {
    final u = 1 - t;
    final dx = 3 * u * u * (_p1.dx - _p0.dx) + 6 * u * t * (_p2.dx - _p1.dx) + 3 * t * t * (_p3.dx - _p2.dx);
    final dy = 3 * u * u * (_p1.dy - _p0.dy) + 6 * u * t * (_p2.dy - _p1.dy) + 3 * t * t * (_p3.dy - _p2.dy);
    final len = math.max(1e-4, math.sqrt(dx * dx + dy * dy));
    return Offset(-dy / len, dx / len);
  }
}

class EnergyConduitPainter extends CustomPainter {
  EnergyConduitPainter({required this.state, required this.layout, required Listenable repaint}) : super(repaint: repaint);

  final AudioVisualState state;
  final NexusLayout layout;

  static final GlowMesh _mesh = GlowMesh(3 * 96 * 4);
  static final StrandScratch _scratch = StrandScratch(96);

  @override
  void paint(Canvas canvas, Size size) {
    final s = state;
    final samples = s.qualityTier == 0 ? 48 : 80;
    final strands = s.qualityTier == 0 ? 2 : 3;
    _mesh.reset();
    final textMid = (layout.textTop + layout.textBottom) / 2;
    final textHalf = (layout.textBottom - layout.textTop) / 2 + 10;

    for (var k = 0; k < strands; k++) {
      final geometry = ConduitGeometry(layout, s, strand: k - (strands - 1) / 2);
      final xs = _scratch.xs, ys = _scratch.ys, ws = _scratch.widths, cs = _scratch.colors;
      for (var i = 0; i < samples; i++) {
        final t = i / (samples - 1);
        final p = geometry.at(t);
        xs[i] = p.dx; ys[i] = p.dy;
        var packets = 0.0;
        for (var q = 0; q < 3; q++) {
          final head = (s.flowTravel * (1 + k * .13) + q / 3 + k * .21) % 1.0;
          final d = (t - head).abs();
          final wrapped = math.min(d, 1 - d);
          packets += math.exp(-(wrapped * wrapped) / .0028);
        }
        packets *= s.flowDirection.abs();
        final textFade = 1 - .82 * (1 - smoothstep(0, textHalf, (p.dy - textMid).abs()));
        final coreFade = 1 - smoothstep(.86, 1, t) * .7;
        final micFade = smoothstep(0, .06, t);
        final base = .05 + s.flowStr