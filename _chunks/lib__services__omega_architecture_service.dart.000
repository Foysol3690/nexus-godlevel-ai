import 'dart:convert';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';

enum MayaOmegaRiskLevel { low, medium, high, critical }
enum MayaOmegaConfidence { confirmed, supported, likely, uncertain, conflicting, unknown }
enum MayaOmegaTaskStatus { pending, running, completed, failed, paused, cancelled }

class MayaOmegaEvidence { final String source; final MayaOmegaConfidence confidence; final String summary; final DateTime capturedAt; const MayaOmegaEvidence({required this.source, required this.confidence, required this.summary, required this.capturedAt}); Map<String, dynamic> toJson() => {'source': source, 'confidence': confidence.name, 'summary': summary, 'capturedAt': capturedAt.toUtc().toIso8601String()}; }
class MayaOmegaSkillDefinition { final String id, name, description, category, state; final List<String> permissions, inputTypes, outputTypes; final MayaOmegaRiskLevel risk; final bool reversible; const MayaOmegaSkillDefinition({required this.id, required this.name, required this.description, required this.category, required this.permissions, required this.risk, required this.state, required this.reversible, required this.inputTypes, required this.outputTypes}); Map<String, dynamic> toJson() => {'id': id, 'name': name, 'description': description, 'category': category, 'permissions': permissions, 'risk': risk.name, 'state': state, 'reversible': reversible, 'inputTypes': inputTypes, 'outputTypes': outputTypes}; }
class MayaOmegaAgentDefinition { final String id, name, role; final List<String> skills; final bool enabled; const MayaOmegaAgentDefinition({required this.id, required this.name, required this.role, required this.skills, required this.enabled}); Map<String, dynamic> toJson() => {'id': id, 'name': name, 'role': role, 'skills': skills, 'enabled': enabled}; }
class MayaOmegaModelDefinition { final String id, name, modality; final bool local, onlineRequired; final List<String> strengths; const MayaOmegaModelDefinition({required this.id, required this.name, required this.modality, required this.local, required this.onlineRequired, required this.strengths}); Map<String, dynamic> toJson() => {'id': id, 'name': name, 'modality': modality, 'local': local, 'onlineRequired': onlineRequired, 'strengths': strengths}; }

class MayaOmegaTaskNode {
  final String id, name, objective;
  final List<String> dependsOn;
  MayaOmegaTaskStatus status;
  String expectedState, failureState, recoveryAction, output, error;
  int retryLimit, attempts;
  MayaOmegaTaskNode({required this.id, required this.name, required this.objective, this.dependsOn = const [], this.status = MayaOmegaTaskStatus.pending, this.expectedState = '', this.failureState = '', this.recoveryAction = '', this.retryLimit = 1, this.attempts = 0, this.output = '', this.error = ''});
  Map<String, dynamic> toJson() => {'id': id, 'name': name, 'objective': objective, 'dependsOn': dependsOn, 'status': status.name, 'expectedState': expectedState, 'failureState': failureState, 'recoveryAction': recoveryAction, 'retryLimit': retryLimit, 'attempts': attempts, 'output': output, 'error': error};
}

class MayaOmegaTaskGraph { final String id, goal; final DateTime createdAt; MayaOmegaTaskStatus status; final List<MayaOmegaTaskNode> nodes; final List<MayaOmegaEvidence> evidence; MayaOmegaTaskGraph({required this.id, required this.goal, required this.createdAt, this.status = MayaOmegaTaskStatus.pending, this.nodes = const [], this.evidence = const []}); Map<String, dynamic> toJson() => {'id': id, 'goal': goal, 'createdAt': createdAt.toUtc().toIso8601String(), 'status': status.name, 'nodes': nodes.map((n) => n.toJson()).toList(), 'evidence': evidence.map((e) => e.toJson()).toList()}; }
class MayaOmegaGoal { final String id, title, priority; final DateTime createdAt; final String? deadline; String status; MayaOmegaGoal({required this.id, required this.title, required this.priority, required this.createdAt, required this.deadline, this.status = 'active'}); Map<String, dynamic> toJson() => {'id': id, 'title': title, 'priority': priority, 'createdAt': createdAt.toUtc().toIso8601String(), if (deadline != null && deadline!.isNotEmpty) 'deadline': deadline, 'status': status}; }

class MayaOmegaArchitectureService {
  static const _storage = FlutterSecureStorage();
  static const _graphKey = 'maya_omega_active_task_graph_v1', _goalsKey = 'maya_omega_goals_v1', _lessonsKey = 'maya_omega_recovery_lessons_v1';

  static const agents = <MayaOmegaAgentDefinition>[
    MayaOmegaAgentDefinition(id: 'maya_prime', name: 'MAYA Prime', role: 'User-facing coordinator and final orchestrator.', skills: ['intent', 'context', 'planning', 'verification'], enabled: true),
    MayaOmegaAgentDefinition(id: 'planner', name: 'Planner', role: 'Decomposes goals into ordered tasks and dependencies.', skills: ['planning', 'task_graph'], enabled: true),
    MayaOmegaAgentDefinition(id: 'researcher', name: 'Researcher', role: 'Finds, ranks, extracts, and compares evidence.', skills: ['research', 'citations'], enabled: false),
    MayaOmegaAgentDefinition(id: 'coder', name: 'Coder', role: 'Analyzes and patches code in a sandboxed workspace.', skills: ['coding', 'testing', 'git'], enabled: false),
    MayaOmegaAgentDefinition(id: 'vision', name: 'Vision Agent', role: 'Interprets camera, screen, OCR, and visual state.', skills: ['camera', 'ocr', 'visual_verification'], enabled: true),
    MayaOmegaAgentDefinition(id: 'file', name: 'File Agent', role: 'Works with explicitly scoped files and artifacts.', skills: ['filesystem', 'documents', 'pdf'], enabled: false),
    MayaOmegaAgentDefinition(id: 'browser', name: 'Browser Agent', role: 'Performs permitted, auditable web workflows.', skills: ['browser', 'research'], enabled: false),
    MayaOmegaAgentDefinition(id: 'analyst', name: 'Analyst', role: 'Compares data, detects patterns, and explains findings.', skills: ['analysis', 'evidence'], enabled: false),
    MayaOmegaAgentDefinition(id: 'designer', name: 'Designer', role: 'Creates interface, media, and visual concepts.', skills: ['design', 'media'], enabled: false),
    MayaOmegaAgentDefinition(id: 'tester', name: 'Tester', role: 'Validates expected behavior and regression safety.', skills: ['testing', 'benchmarking'], enabled: false),
    MayaOmegaAgentDefinition(id: 'critic', name: 'Critic', role: 'Challenges assumptions, quality, and security.', skills: ['critique', 'security'], enabled: true),
    MayaOmegaAgentDefinition(id: 'recovery', name: 'Recovery Agent', role: 'Classifies failures and chooses bounded recovery actions.', skills: ['recovery', 'rollback'], enabled: true),
    MayaOmegaAgentDefinition(id: 'verifier', name: 'Verifier', role: 'Checks outputs against requirements and expected state.', skills: ['verification', 'evidence'], enabled: true),
  ];

  static const skills = <MayaOmegaSkillDefinition>[
    MayaOmegaSkillDefinition(id: 'android', name: 'Android Device', description: 'Scoped device actions through Android APIs and Accessibility.', category: 'device', permissions: ['accessibility', 'device_actions'], risk: MayaOmegaRiskLevel.high, state: 'ready', reversible: false, inputTypes: ['device_action'], outputTypes: ['action_result', 'verification']),
    MayaOmegaSkillDefinition(id: 'filesystem', name: 'Scoped Filesystem', description: 'Read/write only inside MAYA private app workspace with read-back verification and delete rollback backups.', category: 'files', permissions: ['workspace_scope'], risk: MayaOmegaRiskLevel.medium, state: 'ready', reversible: true, inputTypes: ['file_path', 'file_operation'], outputTypes: ['file_artifact', 'verification']),
    MayaOmegaSkillDefinition(id: 'camera_vision', name: 'Camera and Vision', description: 'Camera, OCR, visual understanding, and visual verification.', category: 'vision', permissions: ['camera'], risk: MayaOmegaRiskLevel.medium, state: 'ready', reversible: true, inputTypes: ['camera_frame', 'vision_goal'], outputTypes: ['visual_observation', 'confidence']),
    MayaOmegaSkillDefinition(id: 'voice', name: 'Voice Stack', description: 'STT, TTS, live audio, interruption, and fallback handling.', category: 'human', permissions: ['microphone'], risk: MayaOmegaRiskLevel.low, state: 'ready', reversible: true, inputTypes: ['audio'], outputTypes: ['transcript', 'speech']),
    MayaOmegaSkillDefinition(id: 'calendar_reminders', name: 'Calendar and Reminders', description: 'Persistent reminders and future scheduling adapters.', category: 'automation', permissions: ['notifications'], risk: MayaOmegaRiskLevel.medium, state: 'ready', reversible: true, inputTypes: ['reminder'], outputTypes: ['scheduled_job']),
  ];

  static const models = <MayaOmegaModelDefinition>[
    MayaOmegaModelDefinition(id: 'offline_rules', name: 'Offline Local Gateway', modality: 'text', local: true, onlineRequired: false, strengths: ['fallback', 'device_intents', 'low_resource']),
    MayaOmegaModelDefinition(id: 'cloud_general', name: 'Cloud General Model', modality: 'text', local: false, onlineRequired: true, strengths: ['conversation', 'reasoning', 'planning']),
    MayaOmegaModelDefinition(id: 'live_speech', name: 'Live Speech Model', modality: 'audio', local: false, onlineRequired: true, strengths: ['low_latency_voice', 'interruption']),
    MayaOmegaModelDefinition(id: 'vision_model', name: 'Vision Model', modality: 'vision', local: false, onlineRequired: true, strengths: ['ocr', 'scene_analysis', 'visual_verification']),
    MayaOmegaModelDefinition(id: 'code_model', name: 'Coding Model', modality: 'code', local: false, onlineRequired: true, strengths: ['patches', 'tests', 'architecture']),
  ];

  Future<MayaOmegaTaskGraph> createTaskGraph(String goal, {String expectedResult = ''}) async {
    final cleanGoal = goal.trim(); final now = DateTime.now().toUtc(); final id = now.microsecondsSinceEpoch.toString();
    final nodes = <MayaOmegaTaskNode>[MayaOmegaTaskNode(id: 'perceive', name: 'Perceive', objective: 'Collect relevant user, device, network, and tool context.', expectedState: 'Relevant context is available.', failureState: 'Context is missing or permission is denied.', recoveryAction: 'Ask for clarification or request the smallest missing permission.'), MayaOmegaTaskNode(id: 'understand', name: 'Understand', objective: 'Resolve intent, references, constraints, and uncertainty.', dependsOn: const ['perceive'], expectedState: 'A bounded objective is understood.', failureState: 'Intent remains ambiguous.', recoveryAction: 'Ask a focused clarification question.'), MayaOmegaTaskNode(id: 'plan', name: 'Plan', objective: expectedResult.isEmpty ? 'Select agents, skills, model route, and verification criteria.' : 'Plan toward: $expectedResult', dependsOn: const ['understand'], expectedState: 'A reversible plan with dependencies exists.', failureState: 'No safe plan can be formed.', recoveryAction: 'Reduce scope or switch to suggestion mode.'), MayaOmegaTaskNode(id: 'execute', name: 'Execute', objective: 'Run approved skills within their permission and risk scope.', dependsOn: const ['plan'], expectedState: 'Requested work is performed or safely declined.', failureState: 'A skill or model fails.', recoveryAction: 'Classify failure, retry within limit, or use a fallback.', retryLimit: 2), MayaOmegaTaskNode(id: 'verify', name: 'Verify', objective: 'Compare the observed result with the expected result.', dependsOn: const ['execute'], expectedState: 'Outcome is confirmed, supported, or explicitly uncertain.', failureState: 'Observed state does not match the expected state.', recoveryAction: 'Rollback when possible and store a failure lesson.'), MayaOmegaTaskNode(id: 'reflect', name: 'Reflect', objective: 'Store a safe summary, lesson, or reusable procedure.', dependsOn: const ['verify'], expectedState: 'The next run can benefit without changing proven behavior blindly.', failureState: 'Learning data is incomplete or privacy-sensitive.', recoveryAction: 'Discard sensitive details and keep only the minimum lesson.')];
    final graph = MayaOmegaTaskGraph(id: id, goal: cleanGoal, createdAt: now, nodes: nodes);
    await _storage.write(key: _graphKey, value: jsonEncode(graph.toJson()));
    return graph;
  }

  Future<Map<String, dynamic>?> activeTaskGraph() async { final raw = await _storage.read(key: _graphKey); if (raw == null || raw.isEmpty) return null; try { final decoded = jsonDecode(raw); return decoded is Map ? decoded.map((key, value) => MapEntry(key.toString(), value)) : null; } catch (_) { return null; } }
  Future<Map<String, dynamic>> createGoal(String title, {String priority = 'normal', String? deadline}) async { final clean = title.trim(); if (clean.isEmpty) return {'success': false, 'error': 'Goal title is empty.'}; final goals = await _readGoals(); final goal = MayaOmegaGoal(id: DateTime.now().microsecondsSinceEpoch.toString(), title: clean, priority: priority.trim().isEmpty ? 'normal' : priority.trim(), createdAt: DateTime.now().toUtc(), deadline: deadline?.trim()); goals.insert(0, goal.toJson()); if (goals.length > 100) goals.removeRange(100, goals.length); await _storage.write(key: _goalsKey, value: jsonEncode(goals)); return {'success': true, 'goal': goal.toJson()}; }
  Future<Map<String, dynamic>> listGoals() async => {'success': true, 'goals': await _readGoals()};
  Future<Map<String, dynamic>> updateGoal(String id, String status) async { final goals = await _readGoals(); final index = goals.indexWhere((g) => g['id']?.toString() == id); if (index < 0) return {'success': false, 'error': 'Goal not found.'}; goals[index]['status'] = status.trim().isEmpty ? 'active' : status.trim(); goals[index]['updatedAt'] = DateTime.now().toUtc().toIso8601String(); await _storage.write(key: _goalsKey, value: jsonEncode(goals)); return {'success': true, 'goal': goals[index]}; }

  Map<String, dynamic> routeModel({required String taskKind, required bool online, bool lowBattery = false, bool lowMemory = false}) { final kind = taskKind.toLowerCase(); String selected, reason; if (!online || lowBattery || lowMemory) { selected = 'offline_rules'; reason = !online ? 'Network unavailable.' : lowBattery ? 'Battery-constrained routing.' : 'Memory-constrained routing.'; } else if (kind.contains('vision') || kind.contains('image') || kind.contains('screen')) { selected = 'vision_model'; reason = 'Visual task requires vision capability.'; } else if (kind.contains('code') || kind.contains('repository') || kind.contains('build')) { selected = 'code_model'; reason = 'Engineering task requires code capability.'; } else if (kind.contains('voice') || kind.contains('speech')) { selected = 'live_speech'; reason = 'Low-latency speech task.'; } else if (kind.contains('memory') || kind.contains('embedding')) { selected = 'embedding_model'; reason = 'Semantic memory task.'; } else { selected = 'cloud_general'; reason = 'General online reasoning task.'; } return {'modelId': selected, 'reason': reason, 'online': online, 'lowBattery': lowBattery, 'lowMemory': lowMemory}; }
  Map<String, dynamic> classifyFailure(String error) { final text = error.toLowerCase(); if (text.contains('permission') || text.contains('accessibility') || text.contains('unauthorized')) return {'type': 'permission_denied', 'recovery': 'Request the smallest missing permission and retry only after approval.'}; if (text.contains('network') || text.contains('timeout') || text.contains('connection')) return {'type': 'network_or_timeout', 'recovery': 'Use the next provider or offline route, then verify the result.'}; if (text.contains('rate') || text.contains('quota')) return {'type': 'provider_limit', 'recovery': 'Back off and route to an available provider.'}; if (text.contains('invalid') || text.contains('argument')) return {'type': 'invalid_input', 'recovery': 'Stop and ask for corrected or narrower input.'}; return {'type': 'unknown_failure', 'recovery': 'Do not silently retry; inspect, bound the retry, and verify.'}; }

  Future<Map<String, dynamic>> snapshot({Map<String, dynamic> resourceState = const {}}) async => {'agents': agents.map((a) => a.toJson()).toList(), 'skills': skills.map((s) => s.toJson()).toList(), 'models': models.map((m) => m.toJson()).toList(), 'goals': await _readGoals(), 'activeTaskGraph': await activeTaskGraph(), 'recentLessons': await lessons(), 'resourceState': resourceState};
  Future<List<Map<String, dynamic>>> lessons({int limit = 20}) async { final items = await _readLessons(); return items.take(limit.clamp(1, 100).toInt()).toList(); }
  Future<List<Map<String, dynamic>>> _readLessons() async { final raw = await _storage.read(key: _lessonsKey); if (raw == null || raw.isEmpty) return []; try { final decoded = jsonDecode(raw); if (decoded is List) return decoded.whereType<Map>().map((item) => item.map((key, value) => MapEntry(key.toString(), value))).toList(); } catch (_) {} return []; }
  Future<List<Map<String, dynamic>>> _readGoals() async { final raw = await _storage.read(key: _goalsKey); if (raw == null || raw.isEmpty) return []; try { final decoded = jsonDecode(raw); if (decoded is List) return decoded.whereType<Map>().map((item) => item.map((key, value) => MapEntry(key.toString(), value))).toList(); } catch (_) {} return []; }
}
