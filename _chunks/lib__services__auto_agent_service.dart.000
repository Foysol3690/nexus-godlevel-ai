import 'dart:math' as math;
import 'dart:async';
import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'god_level_ai_service.dart';
import 'safe_log.dart';

enum AgentTaskStatus { pending, running, success, failed, skipped }

class AgentTask {
  final String id, title, description;
  final List<String> dependsOn;
  AgentTaskStatus status; String? result, errorMessage; int retryCount; DateTime? startedAt, completedAt;
  AgentTask({required this.id, required this.title, required this.description, this.dependsOn = const [], this.status = AgentTaskStatus.pending, this.result, this.errorMessage, this.retryCount = 0});
  Duration? get duration => startedAt != null && completedAt != null ? completedAt!.difference(startedAt!) : null;
  Map<String, dynamic> toJson() => {'id': id, 'title': title, 'description': description, 'status': status.name, 'result': result, 'error': errorMessage, 'retries': retryCount};
}

class AgentPlan {
  final String goal; final List<AgentTask> tasks; final DateTime createdAt; bool isExecuting, isComplete; String? finalSynthesis;
  AgentPlan({required this.goal, required this.tasks, DateTime? createdAt, this.isExecuting = false, this.isComplete = false, this.finalSynthesis}) : createdAt = createdAt ?? DateTime.now();
  int get completedCount => tasks.where((t) => t.status == AgentTaskStatus.success).length;
  int get failedCount => tasks.where((t) => t.status == AgentTaskStatus.failed).length;
  double get progress => tasks.isEmpty ? 0 : completedCount / tasks.length;
  bool get allDone => tasks.every((t) => t.status == AgentTaskStatus.success || t.status == AgentTaskStatus.failed || t.status == AgentTaskStatus.skipped);
}

class AutoAgentService extends ChangeNotifier {
  static final AutoAgentService _instance = AutoAgentService._();
  factory AutoAgentService() => _instance;
  AutoAgentService._();
  final _ai = GodLevelAIService();
  AgentPlan? currentPlan; final List<AgentPlan> completedPlans = [];
  bool isPlanning = false; String statusMessage = '';

  Future<AgentPlan> executeGoal(String goal, {Map<String, GodTool>? tools}) async {
    isPlanning = true; statusMessage = 'Planning tasks for: $goal'; notifyListeners();
    try {
      final plan = await _generatePlan(goal); currentPlan = plan; isPlanning = false; notifyListeners();
      plan.isExecuting = true; notifyListeners();
      await _executePlan(plan, tools ?? {});
      statusMessage = 'Synthesizing results...'; notifyListeners();
      plan.finalSynthesis = await _synthesizeResults(plan);
      plan.isExecuting = false; plan.isComplete = true;
      completedPlans.add(plan); if (completedPlans.length > 20) completedPlans.removeAt(0);
      statusMessage = 'Goal completed!'; notifyListeners(); return plan;
    } catch (e) { isPlanning = false; statusMessage = 'Agent failed: $e'; notifyListeners(); MayaSafeLog.debug('AutoAgent', 'Goal execution failed: $e'); rethrow; }
  }

  Future<AgentPlan> _generatePlan(String goal) async {
    final planPrompt = 'Break down this goal into 3-6 specific, actionable tasks.\nReturn ONLY valid JSON in this exact format:\n{\n  "tasks": [\n    {"id": "t1", "title": "Short title", "description": "What to do", "dependsOn": []},\n    {"id": "t2", "title": "Short title", "description": "What to do", "dependsOn": ["t1"]}\n  ]\n}\n\nGoal: $goal\n\nRules:\n- Each task must be concrete and executable\n- Use dependsOn to order tasks that require earlier results\n- 3-6 tasks maximum\n- Return only JSON, no other text';
    final rawPlan = await _ai.chat(planPrompt, mode: ReasoningMode.fast, stream: false);
    try {
      final jsonStr = _extractJson(rawPlan.text);
      final data = jsonDecode(jsonStr) as Map<String, dynamic>;
      final taskList = (data['tasks'] as List).map((t) { final m = t as Map<String, dynamic>; return AgentTask(id: m['id']?.toString() ?? 't${DateTime.now().millisecondsSinceEpoch}', title: m['title']?.toString() ?? 'Task', description: m['description']?.toString() ?? '', dependsOn: (m['dependsOn'] as List?)?.map((d) => d.toString()).toList() ?? []); }).toList();
      return AgentPlan(goal: goal, tasks: taskList);
    } catch (e) { return AgentPlan(goal: goal, tasks: [AgentTask(id: 't1', title: 'Complete goal', description: goal)]); }
  }

  Future<void> _executePlan(AgentPlan plan, Map<String, GodTool> tools) async {
    const maxRetries = 2; final executionOrder = _topologicalSort(plan.tasks);
    for (final task in executionOrder) {
      final deps = task.dependsOn;
      final depsOk = deps.every((depId) { final dep = plan.tasks.firstWhere((t) => t.id == depId, orElse: () => AgentTask(id: '', title: '', description: '')); return dep.status == AgentTaskStatus.success; });
      if (!depsOk) { task.status = AgentTaskStatus.skipped; statusMessage = 'Skipping: ${task.title} (dependencies not met)'; notifyListeners(); continue; }
      bool succeeded = false;
      while (!succeeded && task.retryCount <= maxRetries) {
        task.status = AgentTaskStatus.running; task.startedAt = DateTime.now(); statusMessage = 'Executing: ${task.title}'; notifyListeners();
        try {
          final context = _buildExecutionContext(plan, task);
          final execPrompt = 'Execute this specific task. Be precise and complete.\n\nGoal: ${plan.goal}\nTask: ${task.title}\nTask description: ${task.description}\nContext from completed tasks:\n$context\n\nComplete this task thoroughly. Return only the result of the task execution.';
          final result = await _ai.chat(execPrompt, mode: ReasoningMode.balanced, stream: false);
          task.result = result.text; task.status = AgentTaskStatus.success; task.completedAt = DateTime.now(); succeeded = true; statusMessage = '✅ Completed: ${task.title}'; notifyListeners();
        } catch (e) {
          task.retryCount++;
          if (task.retryCount > maxRetries) { task.status = AgentTaskStatus.failed; task.errorMessage = e.toString(); task.completedAt = DateTime.now(); statusMessage = '❌ Failed: ${task.title}'; notifyListeners(); } else { statusMessage = '🔄 Retrying: ${task.title} (attempt ${task.retryCount})'; notifyListeners(); await Future.delayed(const Duration(milliseconds: 500)); }
        }
      }
    }
  }

  Future<String> _synthesizeResults(AgentPlan plan) async {
    final results = plan.tasks.where((t) => t.status == AgentTaskStatus.success && t.result != null).map((t) => '**${t.title}**:\n${t.result}').join('\n\n');
    if (results.isEmpty) return 'All tasks failed. Please try a different approach or break down the goal further.';
    final synthesisPrompt = 'Synthesize these task results into a coherent, complete answer.\n\nOriginal goal: ${plan.goal}\n\nTask results:\n$results\n\nProvide a clear, well-structured synthesis. Don\'t just list the tasks — integrate the results into a unified answer.';
    final synthesis = await _ai.chat(synthesisPrompt, mode: ReasoningMode.fast, stream: false);
    return synthesis.text;
  }

  String _buildExecutionContext(AgentPlan plan, AgentTask currentTask) {
    final completed = plan.tasks.where((t) => t.status == AgentTaskStatus.success && t.id != currentTask.id).map((t) => '${t.title}: ${t.result?.substring(0, math.min(200, t.result!.length))}...').join('\n');
    return completed.isEmpty ? 'No previous results.' : completed;
  }

  List<AgentTask> _topologicalSort(List<AgentTask> tasks) {
    final sorted = <AgentTask>[], visited = <String>{};
    void visit(AgentTask task) { if (visited.contains(task.id)) return; visited.add(task.id); for (final depId in task.dependsOn) { final dep = tasks.firstWhere((t) => t.id == depId, orElse: () => AgentTask(id: depId, title: '', description: '')); if (dep.id.isNotEmpty) visit(dep); } sorted.add(task); }
    for (final task in tasks) visit(task);
    return sorted;
  }

  String _extractJson(String text) { final jsonRegex = RegExp(r'\{[\s\S]*\}'); final match = jsonRegex.firstMatch(text); if (match != null) return match.group(0)!; return text.trim(); }
  void cancelCurrentPlan() { currentPlan?.isExecuting = false; currentPlan = null; statusMessage = 'Agent cancelled.'; notifyListeners(); }
}
