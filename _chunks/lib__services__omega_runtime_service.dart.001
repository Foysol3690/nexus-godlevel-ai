  Future<void> emergencyStop({String reason = 'Owner requested emergency stop.'}) async {
    await start(); final taskId = _activeTaskId;
    if (taskId != null) await architecture.finishTaskGraph(taskId, success: false, message: reason);
    _halted = true; _activeTaskId = null;
    _emit(MayaOmegaEventKind.emergencyStopped, {'reason': reason});
  }

  Future<void> resume() async { await start(); _halted = false; _emit(MayaOmegaEventKind.runtimeResumed, {'mode': _mode.name}); }

  Future<Map<String, dynamic>> status() async {
    await start();
    List<Map<String, dynamic>> persistedEvents = [], agentMessages = [];
    Map<String, dynamic> graphMemorySnapshot = {}, userModel = {};
    try { persistedEvents = await persistence.recentEvents(limit: 50); agentMessages = await persistence.recentAgentMessages(limit: 50); } catch (_) {}
    try { graphMemorySnapshot = await graphMemory.snapshot(limit: 100); userModel = await proactive.snapshot(); } catch (_) {}
    return {'success': true, 'runtime': 'maya_omega', 'mode': _mode.name, 'halted': _halted, 'activeTaskId': _activeTaskId, 'worldState': Map<String, dynamic>.from(_worldState), 'defaultModelRoute': architecture.routeModel(taskKind: 'general', online: _worldState['online'] == true, lowBattery: _worldState['lowBattery'] == true, lowMemory: _worldState['lowMemory'] == true), 'capabilityCount': _capabilities.length, 'capabilities': _capabilities.values.map((capability) => {'id': _capabilityId(capability.title), 'title': capability.title, 'category': capability.category, 'state': capability.state.name, 'description': capability.description}).toList(), 'recentEvents': _recentEvents.map((event) => event.toJson()).toList(), 'persistedEvents': persistedEvents, 'agentMessages': agentMessages, 'graphMemory': graphMemorySnapshot, 'userModel': userModel, 'architecture': await architecture.snapshot(resourceState: Map<String, dynamic>.from(_worldState))};
  }

  Map<String, dynamic> hudSnapshot() => {'runtime': 'maya_omega', 'mode': _mode.name, 'halted': _halted, 'activeTaskId': _activeTaskId, 'worldState': Map<String, dynamic>.from(_worldState), 'lastEvent': _recentEvents.isEmpty ? null : _recentEvents.first.toJson()};

  void dispose() { _eventController.close(); unawaited(persistence.close()); }

  void _emit(MayaOmegaEventKind kind, Map<String, dynamic> payload) {
    final event = MayaOmegaEvent(id: _newId(), kind: kind, at: DateTime.now().toUtc(), payload: _redactMap(payload));
    _recentEvents.insert(0, event); if (_recentEvents.length > 100) _recentEvents.removeRange(100, _recentEvents.length);
    if (!_eventController.isClosed) _eventController.add(event);
    unawaited(persistence.recordEvent(event.toJson()).catchError((_) {}));
  }

  static String _newId() => DateTime.now().microsecondsSinceEpoch.toString();
  static String _capabilityId(String title) => title.toLowerCase().replaceAll(RegExp(r'[^a-z0-9]+'), '_').replaceAll(RegExp(r'^_|_$'), '');
  static MayaOmegaMode _modeFromSettings(String value) {
    switch (value.trim().toLowerCase()) {
      case 'observe': return MayaOmegaMode.observe;
      case 'suggest': return MayaOmegaMode.suggest;
      case 'execute': return MayaOmegaMode.execute;
      case 'automate': return MayaOmegaMode.automate;
      case 'confirm': case 'adaptive': default: return MayaOmegaMode.confirm;
    }
  }
  static Map<String, dynamic> _redactMap(Map<dynamic, dynamic> source) {
    final output = <String, dynamic>{};
    for (final entry in source.entries) {
      final key = entry.key.toString(); final lower = key.toLowerCase();
      if (lower.contains('token') || lower.contains('secret') || lower.contains('password') || lower.contains('apikey') || lower.contains('api_key') || lower.contains('authorization')) { output[key] = '[REDACTED]'; }
      else if (entry.value is Map) { output[key] = _redactMap(entry.value as Map); }
      else if (entry.value is List) { output[key] = (entry.value as List).map((value) => value is Map ? _redactMap(value) : value).toList(); }
      else { output[key] = entry.value; }
    }
    return output;
  }
}
