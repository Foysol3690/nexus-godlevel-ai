    final shimX = size.width  * (.50 + math.cos(t * .62) * .22);
    final shimY = size.height * (.50 + math.sin(t * .48) * .18);
    canvas.drawRRect(shape, Paint()..blendMode = BlendMode.plus..shader = RadialGradient(center: Alignment((shimX / size.width - .5) * 2, (shimY / size.height - .5) * 2), radius: .55, colors: [accent.withValues(alpha: .06 + glow * .05), Colors.transparent]).createShader(rect));

    canvas.drawRRect(shape.deflate(.5), Paint()..style = PaintingStyle.stroke..strokeWidth = 1.2..shader = SweepGradient(transform: GradientRotation(t * .28), colors: [Colors.white.withValues(alpha: .30 + glow * .14), accent.withValues(alpha: .14 + glow * .18), Colors.white.withValues(alpha: .04), const Color(0xFF2DEBFF).withValues(alpha: .08 + glow * .12), Colors.white.withValues(alpha: .30 + glow * .14)], stops: const [0, .25, .50, .75, 1]).createShader(rect));

    canvas.drawRRect(shape, Paint()..shader = RadialGradient(center: const Alignment(-.55, -.65), radius: .55, colors: [Colors.white.withValues(alpha: .14 + glow * .10), Colors.white.withValues(alpha: 0)]).createShader(rect));

    canvas.drawRRect(shape.deflate(.6), Paint()..style = PaintingStyle.stroke..strokeWidth = .8..shader = LinearGradient(begin: Alignment.topRight, end: Alignment.bottomLeft, colors: [Colors.white.withValues(alpha: 0), accent.withValues(alpha: .10 + glow * .20), Colors.white.withValues(alpha: 0)], stops: const [0, .55, 1]).createShader(rect));
  }

  @override
  bool shouldRepaint(_GlassSurfacePainter old) => old.circle != circle || old.radius != radius || old.state != state || (state != null);
}
