import 'dart:convert';

import 'package:flutter_secure_storage/flutter_secure_storage.dart';

typedef MayaPlanToolRunner = Future<Map<String, dynamic>> Function(String tool, Map<String, dynamic> arguments);

class AgenticPlannerService {
  static const _storage = FlutterSecureStorage();
  static const _key = 'maya_v7_agent_plans';
  static const _allowedTools = <String>{
    'set_flashlight','set_brightness','send_notification','open_app','open_play_store','open_url','search_web','play_youtube',
    'open_hotspot_settings','set_volume','adjust_volume','set_ringer_mode','read_screen','click_text','tap','swipe',
    'recent_notifications','remember','lock_screen','request_secure_unlock','prepare_whatsapp_message','confirm_whatsapp_message',
    'prepare_whatsapp_call','confirm_whatsapp_call','cancel_whatsapp_call','prepare_cellular_call','confirm_cellular_call',
    'cancel_cellular_call','prepare_whatsapp_gallery_share','confirm_whatsapp_gallery_share','cancel_whatsapp_gallery_share',
  };
  static const _sensitiveTools = <String>{
    'lock_screen','request_secure_unlock','confirm_whatsapp_message','confirm_whatsapp_call',
    'confirm_cellular_call','confirm_whatsapp_gallery_share','open_play_store',
  };

  Future<Map<String, dynamic>> create({required String name, required List<dynamic> rawSteps}) async {
    final cleanName = name.trim();
    if (cleanName.isEmpty) return {'success': false, 'error': 'Plan name is empty'};
    if (rawSteps.isEmpty || rawSteps.length > 20) return {'success': false, 'error': 'A plan needs 1–20 approved steps'};
    final steps = <Map<String, dynamic>>[];
    for (final raw in rawSteps) {
      if (raw is! Map) return {'success': false, 'error': 'Every plan step must be an object'};
      final tool = raw['tool']?.toString().trim() ?? '';
      if (!_allowedTools.contains(tool) || tool == 'run_agent_plan') return {'success': false, 'error': 'Unsupported plan tool: $tool'};
      final args = raw['arguments'];
      steps.add({'tool': tool, 'arguments': args is Map ? args.map((key, value) => MapEntry(key.toString(), value)) : <String, dynamic>{}});
    }
    final plans = await _read();
    final id = DateTime.now().microsecondsSinceEpoch.toString();
    plans.add({'id': id, 'name': cleanName, 'steps': steps, 'status': 'pending', 'createdAt': DateTime.now().toUtc().toIso8601String(), 'results': <dynamic>[]});
    await _write(plans);
    return {'success': true, 'planId': id, 'name': cleanName, 'stepCount': steps.length, 'confirmationRequired': steps.any((step) => _sensitiveTools.contains(step['tool']))};
  }

  Future<Map<String, dynamic>> run({required String planId, required bool confirmed, required MayaPlanToolRunner toolRunner}) async {
    final plans = await _read();
    final index = plans.indexWhere((plan) => plan['id']?.toString() == planId);
    if (index < 0) return {'success': false, 'error': 'Plan not found'};
    final plan = plans[index];
    final steps = (plan['steps'] as List? ?? const []).whereType<Map>().toList();
    if (steps.any((step) => _sensitiveTools.contains(step['tool'])) && !confirmed)
      return {'success': false, 'confirmationRequired': true, 'message': 'This plan contains a sensitive step. Ask for immediate confirmation before running it.'};
    plan['status'] = 'running';
    await _write(plans);
    final outcomes = <Map<String, dynamic>>[];
    for (var i = 0; i < steps.length; i++) {
      final step = steps[i];
      final tool = step['tool']?.toString() ?? '';
      final args = step['arguments'] is Map ? (step['arguments'] as Map).map((key, value) => MapEntry(key.toString(), value)) : <String, dynamic>{};
      Map<String, dynamic> outcome = <String, dynamic>{};
      for (var attempt = 1; attempt <= 2; attempt++) {
        try { outcome = await toolRunner(tool, args); }
        catch (error) { outcome = {'success': false, 'error': error.toString()}; }
        if (outcome['success'] == true || outcome['confirmationRequired'] == true) break;
      }
      outcomes.add({'step': i + 1, 'tool': tool, ...outcome});
      if (outcome['success'] != true) {
        plan['status'] = outcome['confirmationRequired'] == true ? 'paused' : 'failed';
        plan['results'] = outcomes; await _write(plans);
        return {'success': false, 'planId': planId, 'status': plan['status'], 'failedStep': i + 1, 'outcomes': outcomes};
      }
    }
    plan['status'] = 'completed'; plan['completedAt'] = DateTime.now().toUtc().toIso8601String(); plan['results'] = outcomes;
    await _write(plans);
    return {'success': true, 'planId': planId, 'status': 'completed', 'outcomes': outcomes};
  }

  Future<Map<String, dynamic>> list() async {
    final plans = await _read();
    return {'success': true, 'plans': plans.map((plan) => {'id': plan['id'], 'name': plan['name'], 'status': plan['status'], 'stepCount': (plan['steps'] as List? ?? const []).length}).toList()};
  }

  Future<List<Map<String, dynamic>>> _read() async {
    final raw = await _storage.read(key: _key);
    if (raw == null || raw.isEmpty) return <Map<String, dynamic>>[];
    try {
      final decoded = jsonDecode(raw);
      if (decoded is List) return decoded.whereType<Map>().map((item) => item.map((key, value) => MapEntry(key.toString(), value))).toList();
    } catch (_) {}
    return <Map<String, dynamic>>[];
  }

  Future<void> _write(List<Map<String, dynamic>> plans) =>
      _storage.write(key: _key, value: jsonEncode(plans));
}
