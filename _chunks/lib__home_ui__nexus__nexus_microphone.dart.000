import 'dart:math' as math;

import 'package:flutter/material.dart';

import 'audio_visual_state.dart';
import 'nexus_glass_layer.dart';
import 'nexus_palette.dart';

class NexusMicrophone extends StatefulWidget {
  const NexusMicrophone({super.key, required this.state, required this.repaint, required this.qualityTier, required this.active, required this.onTap});
  final AudioVisualState state; final Listenable repaint; final ValueNotifier<int> qualityTier; final bool active; final VoidCallback onTap;
  @override
  State<NexusMicrophone> createState() => _NexusMicrophoneState();
}

class _NexusMicrophoneState extends State<NexusMicrophone> {
  bool _pressed = false;
  void _setPressed(bool value) { if (_pressed != value) setState(() => _pressed = value); }

  @override
  Widget build(BuildContext context) {
    return Semantics(
      button: true, label: widget.active ? 'Stop Maya' : 'Talk to Maya',
      child: GestureDetector(
        behavior: HitTestBehavior.opaque,
        onTapDown: (_) => _setPressed(true), onTapCancel: () => _setPressed(false), onTapUp: (_) => _setPressed(false), onTap: widget.onTap,
        child: AnimatedScale(
          scale: _pressed ? .93 : 1, duration: const Duration(milliseconds: 140), curve: Curves.easeOutCubic,
          child: CustomPaint(
            painter: _MicHaloPainter(state: widget.state, repaint: widget.repaint),
            foregroundPainter: _MicRingPainter(state: widget.state, repaint: widget.repaint),
            child: NexusGlass(
              circle: true, blur: 10, state: widget.state, qualityTier: widget.qualityTier,
              child: Center(child: FractionallySizedBox(widthFactor: .72, heightFactor: .72, child: DecoratedBox(decoration: BoxDecoration(shape: BoxShape.circle, gradient: RadialGradient(center: const Alignment(-.3, -.35), colors: [const Color(0xFF1A2A52).withValues(alpha: .55), const Color(0xFF040A1A).withValues(alpha: .72)]), border: Border.all(color: Colors.white.withValues(alpha: .08), width: .8)), child: const RepaintBoundary(child: CustomPaint(painter: _MicGlyphPainter()))))),
            ),
          ),
        ),
      ),
    );
  }
}

class _MicHaloPainter extends CustomPainter {
  _MicHaloPainter({required this.state, required Listenable repaint}) : super(repaint: repaint);
  final AudioVisualState state;
  @override
  void paint(Canvas canvas, Size size) {
    final s = state; final c = size.center(Offset.zero); final r = size.shortestSide / 2;
    final level = s.amplitude * s.micFocus; final radius = r * (1.9 + level * .9);
    canvas.drawCircle(c, radius, Paint()..blendMode = BlendMode.plus..shader = RadialGradient(colors: [s.accent.withValues(alpha: .1 + s.micFocus * .08 + level * .3), s.accent.withValues(alpha: .02), Colors.transparent], stops: const [.35, .62, 1]).createShader(Rect.fromCircle(center: c, radius: radius)));
  }
  @override
  bool shouldRepaint(_MicHaloPainter old) => false;
}

class _MicRingPainter extends CustomPainter {