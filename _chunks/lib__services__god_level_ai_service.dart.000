import 'dart:async';
import 'dart:convert';
import 'dart:math' as math;
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import '../secure_config_manager.dart';
import 'safe_log.dart';

enum GodLevelModel { gemini15Pro, gemini20Flash, gemini31Pro, gemini38Flash, gpt4o, gpt4oMini, claude35Sonnet, claude3Haiku, groqLlama3, groqMixtral, mistralLarge, cerebrasLlama, auto }
enum ReasoningMode { fast, balanced, quantum, autonomous }
enum UserEmotion { neutral, happy, frustrated, anxious, curious, urgent }

class ThinkingStep { final String label, content; final DateTime timestamp; final Duration elapsed; final bool isComplete; ThinkingStep({required this.label, required this.content, required this.timestamp, required this.elapsed, this.isComplete = false}); }

class GodLevelResponse { final String text; final String? critique; final List<ThinkingStep> reasoning; final UserEmotion detectedEmotion; final GodLevelModel usedModel; final int inputTokens, outputTokens; final Duration latency; final double confidenceScore; final List<String> suggestedFollowUps; final Map<String, dynamic>? structuredData; const GodLevelResponse({required this.text, this.critique, required this.reasoning, required this.detectedEmotion, required this.usedModel, required this.inputTokens, required this.outputTokens, required this.latency, required this.confidenceScore, required this.suggestedFollowUps, this.structuredData}); }

class ConversationMessage { final String role, content; final DateTime timestamp; final GodLevelModel? model; final UserEmotion? emotion; final List<ThinkingStep> reasoning; ConversationMessage({required this.role, required this.content, DateTime? timestamp, this.model, this.emotion, List<ThinkingStep>? reasoning}) : timestamp = timestamp ?? DateTime.now(), reasoning = reasoning ?? []; Map<String, dynamic> toApiMessage() => {'role': role == 'assistant' || role == 'user' ? role : 'user', 'content': content}; }

typedef GodTool = Future<String> Function(Map<String, dynamic> args);
class GodLevelTool { final String name, description; final Map<String, String> parameters; final GodTool executor; const GodLevelTool({required this.name, required this.description, required this.parameters, required this.executor}); Map<String, dynamic> toSchema() => {'name': name, 'description': description, 'parameters': {'type': 'object', 'properties': {for (final e in parameters.entries) e.key: {'type': 'string', 'description': e.value}}}}; }

class GodLevelAIService extends ChangeNotifier {
  static final GodLevelAIService _instance = GodLevelAIService._();
  factory GodLevelAIService() => _instance;
  GodLevelAIService._();

  final _config = SecureConfigManager();
  final _client = http.Client();
  final _rng = math.Random();

  final List<ConversationMessage> conversation = [];
  final List<ThinkingStep> liveThinking = [];
  bool isThinking = false, isStreaming = false;
  String streamingBuffer = '';
  GodLevelModel activeModel = GodLevelModel.auto;
  ReasoningMode reasoningMode = ReasoningMode.balanced;
  UserEmotion lastDetectedEmotion = UserEmotion.neutral;
  int totalTokensUsed = 0;
  final Map<GodLevelModel, int> modelUsageCounts = {};
  final List<GodLevelTool> registeredTools = [];
  StreamController<String>? _streamCtrl;
  Stream<String>? get tokenStream => _streamCtrl?.stream;

  String _buildSystemPrompt(UserEmotion emotion) {
    final emotionGuidance = switch (emotion) { UserEmotion.frustrated => 'The user seems frustrated. Be extra calm, empathetic, and solution-focused. Validate their feeling first.', UserEmotion.anxious => 'The user seems anxious. Be reassuring, clear, and break things into small steps.', UserEmotion.urgent => 'The user is in a hurry. Be concise and action-oriented. Lead with the answer.', UserEmotion.happy => 'The user is in a good mood. Match their energy — be warm and enthusiastic.', UserEmotion.curious => 'The user is curious. Be thorough, educational, and add interesting details.', UserEmotion.neutral => 'Respond naturally and helpfully.' };
    return 'You are MAYA NEXØRA — a God-Level AI assistant with supreme intelligence. You operate at the bleeding edge of what AI can do.\n\nCore identity:\n• You are warm, brilliant, and genuinely care about the person you are helping.\n• You think deeply before responding — you reason step by step when the problem demands it.\n• You are honest about uncertainty — you never fabricate facts.\n• You adapt your communication style perfectly to the user context and emotion.\n• You are proactive — you anticipate what the user needs next.\n\nGod-level capabilities:\n• Multi-step reasoning with self-critique\n• Tool use and autonomous execution\n• Memory across the entire conversation\n• Code generation and explanation\n• Structured data extraction\n• Emotion-aware responses\n• Proactive follow-up suggestions\n\nEmotion guidance: $emotionGuidance\n\nAlways reply in the same language the user writes in. Be concise when the user wants brevity, deep when they want depth. Lead with clarity. End with value.';
  }

  void addTool(GodLevelTool tool) { registeredTools.removeWhere((t) => t.name == tool.name); registeredTools.add(tool); }
  void setReasoningMode(ReasoningMode mode) { reasoningMode = mode; notifyListeners(); }
  void setModel(GodLevelModel model) { activeModel = model; notifyListeners(); }
  void clearConversation() { conversation.clear(); liveThinking.clear(); streamingBuffer = ''; notifyListeners(); }

  Future<GodLevelResponse> chat(String userMessage, {ReasoningMode? mode, GodLevelModel? forceModel, bool stream = true}) async {
    final effectiveMode = mode ?? reasoningMode;
    final start = DateTime.now();
    final emotion = _detectEmotion(userMessage);
    lastDetectedEmotion = emotion;
    conversation.add(ConversationMessage(role: 'user', content: userMessage, emotion: emotion));
    isThinking = true; liveThinking.clear(); streamingBuffer = ''; notifyListeners();
    _streamCtrl?.close();
    _streamCtrl = StreamController<String>.broadcast();
    try {
      final response = switch (effectiveMode) {
        ReasoningMode.fast => await _fastQuery(userMessage, emotion: emotion, forceModel: forceModel, startTime: start),
        ReasoningMode.balanced => await _balancedQuery(userMessage, emotion: emotion, forceModel: forceModel, startTime: start),
        ReasoningMode.quantum => await _quantumReasoningQuery(userMessage, emotion: emotion, forceModel: forceModel, startTime: start),
        ReasoningMode.autonomous => await _autonomousAgentQuery(userMessage, emotion: emotion, forceModel: forceModel, startTime: start),
      };
      totalTokensUsed += response.inputTokens + response.outputTokens;
      modelUsageCounts[response.usedModel] = (modelUsageCounts[response.usedModel] ?? 0) + 1;
      conversation.add(ConversationMessage(role: 'assistant', content: response.text, model: response.usedModel, reasoning: response.reasoning));
      return response;
    } finally { isThinking = false; isStreaming = false; _streamCtrl?.close(); _streamCtrl = null; notifyListeners(); }
  }

  Future<GodLevelResponse> _fastQuery(String prompt, {required UserEmotion emotion, GodLevelModel? forceModel, required DateTime startTime}) async {
    _addThinkingStep('🚀 Fast mode', 'Routing to optimal model...'); final model = forceModel ?? _routeModel(prompt, emotion);
    final system = _buildSystemPrompt(emotion); final messages = _buildMessages(system, prompt);
    final text = await _callModel(model, messages, stream: true);
    return GodLevelResponse(text: text, reasoning: List.from(liveThinking), detectedEmotion: emotion, usedModel: model, inputTokens: _estimateTokens(prompt), outputTokens: _estimateTokens(text), latency: DateTime.now().difference(startTime), confidenceScore: 0.82, suggestedFollowUps: _generateFollowUps(text, prompt));
  }

  Future<GodLevelResponse> _balancedQuery(String prompt, {required UserEmotion emotion, GodLevelModel? forceModel, required DateTime startTime}) async {
    _addThinkingStep('🧠 Analysing intent', 'Classifying your request...'); await Future.delayed(const Duration(milliseconds: 100));
    final model = forceModel ?? _routeModel(prompt, emotion); _updateThinkingStep('🧠 Analysing intent', 'Model selected: ${model.name}', complete: true);
    _addThinkingStep('⚡ Generating response', 'Calling ${model.name}...');
    final system = _buildSystemPrompt(emotion); final messages = _buildMessages(system, prompt);
    final draft = await _callModel(model, messages, stream: true); _updateThinkingStep('⚡ Generating response', 'Draft complete.', complete: true);
    _addThinkingStep('🔍 Self-checking', 'Verifying accuracy and completeness...');
    final qualityScore = _selfScore(prompt, draft); _updateThinkingStep('🔍 Self-checking', 'Quality score: ${(qualityScore * 100).round()}%', complete: true);
    return GodLevelResponse(text: draft, reasoning: List.from(liveThinking), detectedEmotion: emotion, usedModel: model, inputTokens: _estimateTokens(prompt), outputTokens: _estimateTokens(draft), latency: DateTime.now().difference(startTime), confidenceScore: qualityScore, suggestedFollowUps: _generateFollowUps(draft, prompt));
  }

  Future<GodLevelResponse> _quantumReasoningQuery(String prompt, {required UserEmotion emotion, GodLevelModel? forceModel, required DateTime startTime}) async {
    _addThinkingStep('🌌 Quantum Init', 'Decomposing problem space...'); await Future.delayed(const Duration(milliseconds: 120));
    final model = forceModel ?? _routeModel(prompt, emotion); _updateThinkingStep('🌌 Quantum Init', 'Model: ${model.name} · Emotion: ${emotion.name}', complete: true);
    _addThinkingStep('⛓️ Chain-of-Thought', 'Reasoning step by step...');
    final cotSystem = '${_buildSystemPrompt(emotion)}\n\nIMPORTANT: Before giving your final answer, think step by step inside <think>...</think> tags.\nStructure:\n<think>\n1. What exactly is being asked?\n2. What do I know that is relevant?\n3. What approach should I take?\n4. Are there edge cases or pitfalls?\n5. What is the best way to communicate the answer?\n</think>\n[Your actual answer here]';
    final cotMessages = _buildMessages(cotSystem, prompt);
    final cotRaw = await _callModel(model, cotMessages, stream: false);
    final thinkMatch = RegExp(r'<think>(.*?)<\/think>', dotAll: true).firstMatch(cotRaw);
    final thinkText = thinkMatch?.group(1)?.trim() ?? '';
    final answerText = cotRaw.replaceAll(RegExp(r'<think>.*?<\/think>', dotAll: true), '').trim();
    _updateThinkingStep('⛓️ Chain-of-Thought', thinkText.isNotEmpty ? thinkText : 'Reasoning complete.', complete: true);
    _addThinkingStep('🪩 Self-Critique', 'Evaluating my own answer...');
    final critiquePrompt = 'Briefly critique this answer (2-3 sentences). Is it accurate, complete, and well-phrased?\n\nQuestion: $prompt\n\nAnswer: $answerText\n\nCritique:';
    final critique = await _callModel(model, [{'role': 'user', 'content': critiquePrompt}], stream: false);
    _updateThinkingStep('🪩 Self-Critique', critique, complete: true);
    String finalAnswer = answerText;
    final lowerCritique = critique.toLowerCase();
    if (lowerCritique.contains('incomplete') || lowerCritique.contains('incorrect') || lowerCritique.contains('missing')) {
      _addThinkingStep('✨ Refinement', 'Improving based on critique...');
      final refineMessages = [...cotMessages, {'role': 'assistant', 'content': answerText}, {'role': 'user', 'content': 'Improve your answer based on this critique: $critique'}];
      finalAnswer = await _callModel(model, refineMessages, stream: true);
      _updateThinkingStep('✨ Refinement', 'Answer refined.', complete: true);
    } else { _simulateStream(answerText); }
    final quality = _selfScore(prompt, finalAnswer);
    return GodLevelResponse(text: finalAnswer, critique: critique, reasoning: List.from(liveThinking), detectedEmotion: emotion, usedModel: model, inputTokens: _estimateTokens(prompt) * 3, outputTokens: _estimateTokens(finalAnswer), latency: DateTime.now().difference(startTime), confidenceScore: quality, suggestedFollowUps: _generateFollowUps(finalAnswer, prompt));
  }

  Future<GodLevelResponse> _autonomousAgentQuery(String prompt, {required UserEmotion emotion, GodLevelModel? forceModel, required DateTime startTime}) async {
    _addThinkingStep('🤖 Agent Init', 'Starting autonomous agent loop...');
    final model = forceModel ?? _routeModel(prompt, emotion);
    final toolSchemas = registeredTools.map((t) => t.toSchema()).toList();
    final toolList = toolSchemas.isEmpty ? 'No tools registered.' : toolSchemas.map((s) => '• ${s['name']}: ${s['description']}').join('\n');
    final agentSystem = '${_buildSystemPrompt(emotion)}\n\nYou are operating in AUTONOMOUS AGENT MODE. You have access to tools.\nAvailable tools:\n$toolList\n\nTo use a tool, respond with:\n<action>{"tool": "tool_name", "args": {"param": "value"}}</action>\n\nAfter you receive the tool result, continue reasoning and call more tools or give your final answer.\nWhen done, respond with: <final>Your complete answer here</final>';
    final messages = <Map<String, dynamic>>[{'role': 'system', 'content': agentSystem}, {'role': 'user', 'content': prompt}];
    String finalAnswer = ''; int iterations = 0; const maxIterations = 6;
    while (iterations < maxIterations) {
      iterations++; _addThinkingStep('🔄 Agent Step $iterations', 'Thinking...');
      final raw = await _callModel(model, messages, stream: false);
      final finalMatch = RegExp(r'<final>(.*?)<\/final>', dotAll: true).firstMatch(raw);
      if (finalMatch != null) { finalAnswer = finalMatch.group(1)!.trim(); _updateThinkingStep('🔄 Agent Step $iterations', 'Task complete!', complete: true); _simulateStream(finalAnswer); break; }
      final actionMatch = RegExp(r'<action>(.*?)<\/action>', dotAll: true).firstMatch(raw);
      if (actionMatch != null) {
        try { final actionJson = jsonDecode(actionMatch.group(1)!.trim()) as Map<String, dynamic>; final toolName = actionJson['tool']?.toString() ?? ''; final toolArgs = (actionJson['args'] as Map<String, dynamic>?) ?? {}; _updateThinkingStep('🔄 Agent Step $iterations', 'Calling tool: $toolName', complete: false); final tool = registeredTools.firstWhere((t) => t.name == toolName, orElse: () => throw Exception('Tool not found: $toolName')); final result = await tool.executor(toolArgs); _updateThinkingStep('🔄 Agent Step $iterations', 'Tool result: ${result.length > 200 ? result.substring(0, 200) + '...' : result}', complete: true); messages..add({'role': 'assistant', 'content': raw})..add({'role': 'user', 'content': '<tool_result name="$toolName">$result</tool_result>'}); } catch (e) { _updateThinkingStep('🔄 Agent Step $iterations', 'Tool error: $e', complete: true); messages..add({'role': 'assistant', 'content': raw})..add({'role': 'user', 'content': '<tool_result name="error">$e</tool_result>'}); }
      } else { finalAnswer = raw.trim(); _updateThinkingStep('🔄 Agent Step $iterations', 'Direct answer provided.', complete: true); _simulateStream(finalAnswer); break; }
    }
    if (finalAnswer.isEmpty) finalAnswer = 'I completed the reasoning steps but could not produce a final answer. Please try rephrasing your request.';
    return GodLevelResponse(text: finalAnswer, reasoning: List.from(liveThinking), detectedEmotion: emotion, usedModel: model, inputTokens: _estimateTokens(prompt) * iterations, outputTokens: _estimateTokens(finalAnswer), latency: DateTime.now().difference(startTime), confidenceScore: 0.91, suggestedFollowUps: _generateFollowUps(finalAnswer, prompt));
  }

  GodLevelModel _routeModel(String prompt, UserEmotion emotion) {
    if (activeModel != GodLevelModel.auto) return activeModel;
    final lower = prompt.toLowerCase();
    if (lower.contains('code') || lower.contains('function') || lower.contains('bug') || lower.contains('python') || lower.contains('dart') || lower.contains('flutter')) return GodLevelModel.groqLlama3;
    if (lower.contains('write') || lower.contains('story') || lower.contains('essay') || lower.contains('poem') || lower.contains('creative')) return GodLevelModel.claude35Sonnet;
    if (lower.contains('calculate') || lower.contains('math') || lower.contains('solve') || lower.contains('equation') || lower.contains('proof')) return GodLevelModel.gemini15Pro;
    if (emotion == UserEmotion.urgent) return GodLevelModel.groqLlama3;
    return GodLevelModel.gemini31Pro;
  }

  Future<String> _callModel(GodLevelModel model, List<Map<String, dynamic>> messages, {bool stream = false}) async {
    try {
      return switch (model) {
        GodLevelModel.gemini15Pro || GodLevelModel.gemini20Flash || GodLevelModel.gemini31Pro || GodLevelModel.gemini38Flash => await _callGemini(model, messages, stream: stream),
        GodLevelModel.gpt4o || GodLevelModel.gpt4oMini => await _callOpenAI(model, messages, stream: stream),
        GodLevelModel.claude35Sonnet || GodLevelModel.claude3Haiku => await _callClaude(model, messages, stream: stream),
        GodLevelModel.groqLlama3 || GodLevelModel.groqMixtral => await _callGroq(model, messages, stream: stream),
        GodLevelModel.mistralLarge => await _callMistral(messages, stream: stream),
        GodLevelModel.cerebrasLlama => await _callCerebras(messages, stream: stream),
        GodLevelModel.auto => await _callGroq(GodLevelModel.groqLlama3, messages, stream: stream),
      };
    } catch (e) { MayaSafeLog.debug('GodLevelAI', 'Model ${model.name} failed: $e'); return await _fallbackCall(messages); }
  }

  Future<String> _callGemini(GodLevelModel variant, List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getGeminiKey(); if (key == null || key.isEmpty) throw Exception('No Gemini key');
    final modelId = switch (variant) { GodLevelModel.gemini15Pro => 'gemini-1.5-pro-latest', GodLevelModel.gemini31Pro => 'gemini-3.1-pro-latest', GodLevelModel.gemini38Flash => 'gemini-3.8-flash-latest', _ => 'gemini-2.0-flash' };
    final systemMsg = messages.firstWhere((m) => m['role'] == 'system', orElse: () => {}); final chatMessages = messages.where((m) => m['role'] != 'system').toList();
    final contents = chatMessages.map((m) => {'role': m['role'] == 'assistant' ? 'model' : 'user', 'parts': [{'text': m['content']}]}).toList();
    final body = jsonEncode({if (systemMsg.isNotEmpty) 'system_instruction': {'parts': [{'text': systemMsg['content']}]}, 'contents': contents, 'generationConfig': {'temperature': 0.7, 'maxOutputTokens': 4096, 'topP': 0.95}});
    final resp = await _client.post(Uri.parse('https://generativelanguage.googleapis.com/v1beta/models/$modelId:generateContent?key=$key'), headers: {'Content-Type': 'application/json'}, body: body).timeout(const Duration(seconds: 60));
    if (resp.statusCode != 200) throw Exception('Gemini ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = (data['candidates'] as List?)?.firstOrNull?['content']?['parts']?.firstOrNull?['text']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _callOpenAI(GodLevelModel variant, List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getOpenAIKey(); if (key == null || key.isEmpty) throw Exception('No OpenAI key');
    final modelId = variant == GodLevelModel.gpt4oMini ? 'gpt-4o-mini' : 'gpt-4o';
    final resp = await _client.post(Uri.parse('https://api.openai.com/v1/chat/completions'), headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer $key'}, body: jsonEncode({'model': modelId, 'messages': messages, 'temperature': 0.7, 'max_tokens': 4096})).timeout(const Duration(seconds: 60));
    if (resp.statusCode != 200) throw Exception('OpenAI ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = data['choices']?[0]?['message']?['content']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _callClaude(GodLevelModel variant, List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getClaudeKey(); if (key == null || key.isEmpty) throw Exception('No Claude key');
    final modelId = variant == GodLevelModel.claude3Haiku ? 'claude-3-haiku-20240307' : 'claude-3-5-sonnet-20241022';
    final systemMsg = messages.firstWhere((m) => m['role'] == 'system', orElse: () => {}); final chatMsgs = messages.where((m) => m['role'] != 'system').toList();
    final resp = await _client.post(Uri.parse('https://api.anthropic.com/v1/messages'), headers: {'Content-Type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01'}, body: jsonEncode({'model': modelId, 'max_tokens': 4096, if (systemMsg.isNotEmpty) 'system': systemMsg['content'], 'messages': chatMsgs})).timeout(const Duration(seconds: 60));
    if (resp.statusCode != 200) throw Exception('Claude ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = (data['content'] as List?)?.firstOrNull?['text']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _callGroq(GodLevelModel variant, List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getGroqKey(); if (key == null || key.isEmpty) throw Exception('No Groq key');
    final modelId = variant == GodLevelModel.groqMixtral ? 'mixtral-8x7b-32768' : 'llama-3.3-70b-versatile';
    final resp = await _client.post(Uri.parse('https://api.groq.com/openai/v1/chat/completions'), headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer $key'}, body: jsonEncode({'model': modelId, 'messages': messages, 'temperature': 0.7, 'max_tokens': 4096})).timeout(const Duration(seconds: 30));
    if (resp.statusCode != 200) throw Exception('Groq ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = data['choices']?[0]?['message']?['content']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _callMistral(List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getMistralKey(); if (key == null || key.isEmpty) throw Exception('No Mistral key');
    final resp = await _client.post(Uri.parse('https://api.mistral.ai/v1/chat/completions'), headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer $key'}, body: jsonEncode({'model': 'mistral-large-latest', 'messages': messages, 'max_tokens': 4096})).timeout(const Duration(seconds: 45));
    if (resp.statusCode != 200) throw Exception('Mistral ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = data['choices']?[0]?['message']?['content']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _callCerebras(List<Map<String, dynamic>> messages, {bool stream = false}) async {
    final key = await _config.getCerebrasKey(); if (key == null || key.isEmpty) throw Exception('No Cerebras key');
    final resp = await _client.post(Uri.parse('https://api.cerebras.ai/v1/chat/completions'), headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer $key'}, body: jsonEncode({'model': 'llama3.1-70b', 'messages': messages, 'max_tokens': 4096})).timeout(const Duration(seconds: 30));
    if (resp.statusCode != 200) throw Exception('Cerebras ${resp.statusCode}');
    final data = jsonDecode(resp.body) as Map<String, dynamic>;
    final text = data['choices']?[0]?['message']?['content']?.toString() ?? '';
    if (stream) _simulateStream(text); return text;
  }

  Future<String> _fallbackCall(List<Map<String, dynamic>> messages) async {
    for (final tryModel in [GodLevelModel.groqLlama3, GodLevelModel.gemini20Flash, GodLevelModel.mistralLarge, GodLevelModel.cerebrasLlama]) { try { return await _callModel(tryModel, messages, stream: true); } catch (_) { continue; } }
    return "I'm currently unable to reach any AI provider. Please check your API keys in God Mode settings.";
  }

  List<Map<String, dynamic>> _buildMessages(String system, String userPrompt) {
    final msgs = <Map<String, dynamic>>[{'role': 'system', 'content': system}];
    final history = conversation.takeLast(math.min(10, conversation.length)).toList();
    for (final msg in history) { if (msg.role == 'user' || msg.role == 'assistant') { msgs.add(msg.toApiMessage()); } }
    if (msgs.isEmpty || msgs.last['content'] != userPrompt) { msgs.add({'role': 'user', 'content': userPrompt}); }
    return msgs;
  }

  UserEmotion _detectEmotion(String text) {
    final lower = text.toLowerCase();
    if (RegExp(r'urgent|asap|quickly|hurry|emergency|immediately|now!').hasMatch(lower)) return UserEmotion.urgent;
    if (RegExp(r'angry|frustrated|annoyed|terrible|worst|awful|hate|useless').hasMatch(lower)) return UserEmotion.frustrated;
    if (RegExp(r'worried|anxious|scared|nervous|afraid|stress|panic').hasMatch(lower)) return UserEmotion.anxious;
    if (RegExp(r'amazing|great|love|happy|excited|wonderful|awesome|perfect').hasMatch(lower)) return UserEmotion.happy;
    if (RegExp(r'how|why|what if|curious|wonder|interesting|explain|understand').hasMatch(lower)) return UserEmotion.curious;
    return UserEmotion.neutral;
  }

  double _selfScore(String question, String answer) { double score = 0.70; if (answer.length > 50) score += 0.05; if (answer.length > 200) score += 0.05; if (answer.contains('\n')) score += 0.03; if (RegExp(r'```|`').hasMatch(answer)) score += 0.04; if (answer.toLowerCase().contains('example')) score += 0.03; if (answer.contains('?')) score -= 0.02; return score.clamp(0.0, 0.99); }
  List<String> _generateFollowUps(String answer, String question) { final followUps = <String>[]; final lower = answer.toLowerCase(); if (lower.contains('code') || lower.contains('function')) { followUps.add('Can you explain how this works?'); followUps.add('Show me an example with different inputs'); } if (lower.contains('step') || lower.contains('first')) { followUps.add('Can you go deeper on step 2?'); } if (answer.length > 300) followUps.add('Give me a shorter summary'); if (followUps.isEmpty) { followUps.add('Tell me more about this'); followUps.add('What are the alternatives?'); } return followUps.take(3).toList(); }
  int _estimateTokens(String text) => (text.length / 4).round();
  void _addThinkingStep(String label, String content) { final step = ThinkingStep(label: label, content: content, timestamp: DateTime.now(), elapsed: Duration.zero); liveThinking.add(step); notifyListeners(); }
  void _updateThinkingStep(String label, String content, {bool complete = false}) { final idx = liveThinking.indexWhere((s) => s.label == label); if (idx < 0) return; final old = liveThinking[idx]; liveThinking[idx] = ThinkingStep(label: label, content: content, timestamp: old.timestamp, elapsed: DateTime.now().difference(old.timestamp), isComplete: complete); notifyListeners(); }
  void _simulateStream(String text) { isStreaming = true; streamingBuffer = ''; notifyListeners(); const chunkSize = 3; int pos = 0; Timer.periodic(const Duration(milliseconds: 30), (timer) { if (pos >= text.length) { timer.cancel(); isStreaming = false; streamingBuffer = text; notifyListeners(); return; } final end = math.min(pos + chunkSize, text.length); streamingBuffer = text.substring(0, end); _streamCtrl?.add(text.substring(pos, end)); pos = end; notifyListeners(); }); }

  @override
  void dispose() { _client.close(); _streamCtrl?.close(); super.dispose(); }
}

extension ListTakeLast<T> on List<T> { List<T> takeLast(int n) => length <= n ? this : sublist(length - n); }
