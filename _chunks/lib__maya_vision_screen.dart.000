import 'dart:async';
import 'dart:io';
import 'dart:math' as math;
import 'package:camera/camera.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:permission_handler/permission_handler.dart';
import 'services/maya_vision_service.dart';
import 'services/tts_service.dart';

enum MayaCameraLens { front, back }

class MayaVisionScreen extends StatefulWidget {
  final MayaCameraLens initialLens;
  final bool analyzeOnOpen;
  final bool startContinuous;
  const MayaVisionScreen({super.key, this.initialLens = MayaCameraLens.front, this.analyzeOnOpen = false, this.startContinuous = false});
  @override State<MayaVisionScreen> createState() => _MayaVisionScreenState();
}

class _MayaVisionScreenState extends State<MayaVisionScreen> with WidgetsBindingObserver {
  final MayaVisionService _vision = MayaVisionService();
  final TtsService _tts = TtsService();
  final TextEditingController _question = TextEditingController(text: 'What can you see, and what useful help can you offer?');
  CameraController? _camera;
  List<CameraDescription> _cameras = const [];
  MayaCameraLens _lens = MayaCameraLens.front;
  Timer? _continuousTimer, _sessionLimitTimer, _focusTimer;
  bool _initializing = true, _analyzing = false, _continuous = false, _speakResults = true, _torch = false, _immersive = true;
  int _consecutiveFailures = 0;
  String _resolutionLabel = '1080P';
  double _minZoom = 1, _maxZoom = 1, _zoom = 1;
  Offset? _focusPoint;
  String _status = 'Requesting camera permission…', _analysis = 'Maya vision has not analyzed a frame yet.', _provider = '';

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    _lens = widget.initialLens;
    unawaited(SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersiveSticky));
    unawaited(_tts.init());
    unawaited(_initializeCamera(analyzeAfter: widget.analyzeOnOpen, continuousAfter: widget.startContinuous));
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.inactive || state == AppLifecycleState.paused) {
      _stopContinuous(reason: 'Vision paused while Maya is not visible.');
      final camera = _camera; _camera = null;
      unawaited(camera?.dispose());
      if (mounted) setState(() {});
    } else if (state == AppLifecycleState.resumed && _camera == null) {
      unawaited(_initializeCamera());
    }
  }

  Future<void> _initializeCamera({bool analyzeAfter = false, bool continuousAfter = false}) async {
    if (mounted) setState(() { _initializing = true; _status = 'Starting visible camera session…'; });
    final permission = await Permission.camera.request();
    if (!permission.isGranted) {
      if (!mounted) return;
      setState(() { _initializing = false; _status = permission.isPermanentlyDenied ? 'Camera permission is blocked. Enable it in Android Settings.' : 'Camera permission was not granted.'; });
      return;
    }
    try {
      _cameras = await availableCameras();
      if (_cameras.isEmpty) throw StateError('No camera is available on this phone.');
      final wanted = _lens == MayaCameraLens.front ? CameraLensDirection.front : CameraLensDirection.back;
      final selected = _cameras.firstWhere((c) => c.lensDirection == wanted, orElse: () => _cameras.first);
      _lens = selected.lensDirection == CameraLensDirection.front ? MayaCameraLens.front : MayaCameraLens.back;
      final previous = _camera; _camera = null; await previous?.dispose();
      CameraController? controller; Object? initializationError;
      const profiles = <(ResolutionPreset, String)>[(ResolutionPreset.veryHigh, '1080P'), (ResolutionPreset.high, '720P'), (ResolutionPreset.medium, '480P')];
      for (final profile in profiles) {
        final candidate = CameraController(selected, profile.$1, enableAudio: false, imageFormatGroup: ImageFormatGroup.jpeg);
        try { await candidate.initialize(); controller = candidate; _resolutionLabel = profile.$2; break; } catch (error) { initializationError = error; await candidate.dispose(); }
      }
      if (controller == null) throw StateError('Camera initialization failed: $initializationError');
      _camera = controller;
      await controller.setFlashMode(FlashMode.off);
      try { _minZoom = await controller.getMinZoomLevel(); _maxZoom = math.min(await controller.getMaxZoomLevel(), 8.0).toDouble(); _zoom = _minZoom.clamp(_minZoom, _maxZoom).toDouble(); await controller.setZoomLevel(_zoom); } catch (_) { _minZoom = 1; _maxZoom = 1; _zoom = 1; }
      if (!mounted) { await controller.dispose(); return; }
      setState(() { _initializing = false; _torch = false; _status = '${_lens == MayaCameraLens.front ? 'Front' : 'Back'} camera active • $_resolutionLabel analysis • tap preview to focus'; });
      if (analyzeAfter || continuousAfter) { await Future<void>.delayed(const Duration(milliseconds: 650)); if (!mounted) return; if (continuousAfter) { _toggleContinuous(true); } else { await _analyzeFrame(); } }
    } catch (error) { if (!mounted) return; setState(() { _initializing = false; _status = 'Camera failed: ${_short(error)}'; }); }
  }

  Future<void> _switchLens() async { if (_analyzing || _initializing) return; _stopContinuous(); setState(() { _lens = _lens == MayaCameraLens.front ? MayaCameraLens.back : MayaCameraLens.front; }); await _initializeCamera(); }

  Future<void> _toggleTorch() async {
    final controller = _camera;
    if (controller == null || !controller.value.isInitialized) return;
    if (_lens == MayaCameraLens.front) { setState(() => _status = 'Torch is available only on the back camera.'); return; }
    try { _torch = !_torch; await controller.setFlashMode(_torch ? FlashMode.torch : FlashMode.off); if (mounted) setState(() => _status = _torch ? 'Back-camera torch on' : 'Torch off'); } catch (error) { if (mounted) setState(() => _status = 'Torch unavailable: ${_short(error)}'); }
  }

  Future<void> _focusAt(Offset normalized) async {
    final controller = _camera; if (controller == null || !controller.value.isInitialized) return;
    final point = Offset(normalized.dx.clamp(0.0, 1.0).toDouble(), normalized.dy.clamp(0.0, 1.0).toDouble());
    try { await controller.setFocusPoint(point); await controller.setExposurePoint(point); _focusTimer?.cancel(); if (mounted) setState(() { _focusPoint = point; _status = 'Focus and exposure locked at selected point • $_resolutionLabel'; }); _focusTimer = Timer(const Duration(seconds: 2), () { if (mounted) setState(() => _focusPoint = null); }); } catch (error) { if (mounted) setState(() => _status = 'Tap focus unavailable: ${_short(error)}'); }
  }

  Future<void> _setZoom(double value) async {
    final controller = _camera; if (controller == null || !controller.value.isInitialized) return;
    final safe = value.clamp(_minZoom, _maxZoom).toDouble();
    try { await controller.setZoomLevel(safe); if (mounted) setState(() { _zoom = safe; _status = '${safe.toStringAsFixed(1)}× zoom • $_resolutionLabel'; }); } catch (error) { if (mounted) setState(() => _status = 'Zoom unavailable: ${_short(error)}'); }
  }

  Future<void> _analyzeFrame() async {
    final controller = _camera;
    if (_analyzing || controller == null || !controller.value.isInitialized || controller.value.isTakingPicture) return;
    setState(() { _analyzing = true; _status = 'Capturing one frame for the configured cloud vision provider…'; });
    XFile? capture;
    try {
      HapticFeedback.mediumImpact();
      capture = await controller.takePicture();
      final bytes = await capture.readAsBytes();
      if (mounted) setState(() => _status = 'Analyzing with configured vision providers…');
      final result = await _vision.analyze(bytes, question: _question.text.trim().isEmpty ? 'What can you see, and what useful help can you offer?' : _question.text.trim());
      if (!mounted) return;
      setState(() { _analysis = result.text; _provider = result.provider; _status = 'Analysis complete • frame discarded'; _consecutiveFailures = 0; });
      if (_speakResults) await _tts.speak(result.text);
    } catch (error) {
      if (mounted) {
        if (_continuous) _consecutiveFailures += 1;
        final shouldStop = _continuous && _consecutiveFailures >= 3;
        setState(() { _analysis = 'Vision error: ${_short(error)}'; _status = shouldStop ? 'Real-time Vision stopped after 3 consecutive errors • no frame retained' : _continuous ? 'Real-time analysis failed ($_consecutiveFailures/3) • no frame retained' : 'Analysis failed • no frame retained'; });
        if (shouldStop) _stopContinuous();
      }
    } finally { if (capture != null) { try { final file = File(capture.path); if (await file.exists()) await file.delete(); } catch (_) {} } if (mounted) setState(() => _analyzing = false); }
  }

  void _toggleContinuous(bool enabled) {
    if (enabled) {
      final controller = _camera;
      if (controller == null || !controller.value.isInitialized || _initializing) { if (mounted) setState(() => _status = 'Camera is not ready for Real-time Vision.'); return; }
      _continuousTimer?.cancel(); _sessionLimitTimer?.cancel(); _consecutiveFailures = 0;
      setState(() { _continuous = true; _status = 'Real-time Vision active • one visible $_resolutionLabel frame every 6 seconds • 10-minute limit'; });
      unawaited(_analyzeFrame());
      _continuousTimer = Timer.periodic(const Duration(seconds: 6), (_) { if (!_analyzing) unawaited(_analyzeFrame()); });
      _sessionLimitTimer = Timer(const Duration(minutes: 10), () { _stopContinuous(reason: 'Real-time Vision reached its 10-minute safety limit and stopped.'); });
    } else { _stopContinuous(reason: 'Real-time Vision stopped.'); }
  }

  void _stopContinuous({String? reason}) { _continuousTimer?.cancel(); _continuousTimer = null; _sessionLimitTimer?.cancel(); _sessionLimitTimer = null; _consecutiveFailures = 0; if (!mounted) return; setState(() { _continuous = false; if (reason != null) _status = reason; }); }
  Future<void> _openSettings() => openAppSettings();
  Future<void> _setImmersive(bool value) async { await SystemChrome.setEnabledSystemUIMode(value ? SystemUiMode.immersiveSticky : SystemUiMode.edgeToEdge); if (mounted) setState(() => _immersive = value); }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    _stopContinuous();
    _focusTimer?.cancel();
    final cam = _camera; _camera = null;
    cam?.dispose();
    _question.dispose();
    _tts.stop();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      body: SafeArea(
        child: _initializing ? _buildInitializing() : Stack(children: [
          _buildCameraPreview(),
          _buildOverlay(),
          Positioned(top: 0, left: 0, right: 0, child: _buildTopBar()),
          Positioned(bottom: 0, left: 0, right: 0, child: _buildBottomPanel()),
        ]),
      ),
    );
  }

  Widget _buildInitializing() => Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [const CircularProgressIndicator(color: Colors.cyanAccent), const SizedBox(height: 20), Text(_status, style: const TextStyle(color: Colors.white70, fontSize: 14), textAlign: TextAlign.center)]));

  Widget _buildCameraPreview() {
    final controller = _camera;
    if (controller == null || !controller.value.isInitialized) return Container(color: Colors.black, child: Center(child: Text(_status, style: const TextStyle(color: Colors.white54, fontSize: 13), textAlign: TextAlign.center)));
    return GestureDetector(
      onTapUp: (details) { final size = MediaQuery.of(context).size; _focusAt(Offset(details.localPosition.dx / size.width, details.localPosition.dy / size.height)); },
      onScaleUpdate: (details) { if (details.scale != 1.0) _setZoom(_zoom * details.scale); },
      child: SizedBox.expand(child: FittedBox(fit: BoxFit.cover, child: SizedBox(width: controller.value.previewSize!.height, height: controller.value.previewSize!.width, child: CameraPreview(controller)))),
    );
  }

  Widget _buildOverlay() {
    if (_focusPoint == null) return const SizedBox.shrink();
    final size = MediaQuery.of(context).size;
    return Positioned(left: _focusPoint!.dx * size.width - 30, top: _focusPoint!.dy * size.height - 30, child: Container(width: 60, height: 60, decoration: BoxDecoration(shape: BoxShape.circle, border: Border.all(color: Colors.yellowAccent, width: 2))));
  }

  Widget _buildTopBar() => Container(padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8), decoration: BoxDecoration(gradient: LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter, colors: [Colors.black.withOpacity(0.7), Colors.transparent])), child: Row(children: [IconButton(icon: const Icon(Icons.arrow_back_ios_rounded, color: Colors.white), onPressed: () => Navigator.of(context).pop()), Expanded(child: Text(_status, style: const TextStyle(color: Colors.white70, fontSize: 11), maxLines: 1, overflow: TextOverflow.ellipsis)), Text(_provider.isEmpty ? '' : _provider, style: const TextStyle(color: Colors.cyanAccent, fontSize: 10))]));

  Widget _buildBottomPanel() => Container(padding: const EdgeInsets.fromLTRB(12, 12, 12, 20), decoration: BoxDecoration(gradient: LinearGradient(begin: Alignment.bottomCenter, end: Alignment.topCenter, colors: [Colors.black.withOpacity(0.85), Colors.transparent])), child: Column(mainAxisSize: MainAxisSize.min, children: [
    if (_maxZoom > _minZoom) Slider(value: _zoom, min: _minZoom, max: _maxZoom, divisions: ((_maxZoom - _minZoom) * 10).round().clamp(1, 100), label: '${_zoom.toStringAsFixed(1)}×', activeColor: Colors.cyanAccent, inactiveColor: Colors.white24, onChanged: _setZoom),
    Container(margin: const EdgeInsets.only(bottom: 8), padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6), decoration: BoxDecoration(borderRadius: BorderRadius.circular(12), color: Colors.white.withOpacity(0.08)), child: Row(children: [const Icon(Icons.text_fields, color: Colors.white38, size: 16), const SizedBox(width: 6), Expanded(child: TextField(controller: _question, style: const TextStyle(color: Colors.white, fontSize: 13), maxLines: 2, minLines: 1, decoration: const InputDecoration.collapsed(hintText: 'Ask Maya about what she sees…', hintStyle: TextStyle(color: Colors.white24))))])),
    Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
      _iconBtn(Icons.switch_camera_rounded, 'Flip', _switchLens),
      _iconBtn(_torch ? Icons.flashlight_on : Icons.flashlight_off, 'Torch', _toggleTorch),
      GestureDetector(onTap: _analyzing ? null : _analyzeFrame, child: Container(width: 64, height: 64, decoration: BoxDecoration(shape: BoxShape.circle, gradient: _analyzing ? null : const LinearGradient(colors: [Colors.cyanAccent, Colors.blueAccent]), color: _analyzing ? Colors.white24 : null, border: Border.all(color: Colors.white30, width: 2)), child: _analyzing ? const CircularProgressIndicator(color: Colors.cyanAccent, strokeWidth: 2) : const Icon(Icons.center_focus_strong, color: Colors.white, size: 28))),
      _iconBtn(_continuous ? Icons.stop_circle_outlined : Icons.motion_photos_on, _continuous ? 'Stop' : 'Live', () => _toggleContinuous(!_continuous), color: _continuous ? Colors.redAccent : Colors.white70),
      _iconBtn(_speakResults ? Icons.volume_up : Icons.volume_off, 'Speak', () => setState(() => _speakResults = !_speakResults), color: _speakResults ? Colors.cyanAccent : Colors.white70),
    ]),
    const SizedBox(height: 12),
    if (_analysis.isNotEmpty) Container(padding: const EdgeInsets.all(12), decoration: BoxDecoration(borderRadius: BorderRadius.circular(12), color: Colors.black.withOpacity(0.6), border: Border.all(color: Colors.white12)), child: SingleChildScrollView(child: SelectableText(_analysis, style: const TextStyle(color: Colors.white, fontSize: 13, height: 1.5)))),
  ]));

  Widget _iconBtn(IconData icon, String label, VoidCallback onTap, {Color color = Colors.white70}) => GestureDetector(onTap: onTap, child: Column(mainAxisSize: MainAxisSize.min, children: [Icon(icon, color: color, size: 22), const SizedBox(height: 2), Text(label, style: TextStyle(color: color, fontSize: 10))]));
  String _short(Object error) { final s = error.toString(); return s.length > 60 ? s.substring(0, 60) : s; }
}
