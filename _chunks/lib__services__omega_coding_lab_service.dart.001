llback({
    required String relativePath,
    required String checkpointPath,
    required bool confirmed,
  }) async {
    if (!confirmed) return {'success': false, 'confirmationRequired': true, 'error': 'Rollback requires explicit confirmation.'};
    final checkpoint = await filesystem.read(checkpointPath);
    if (checkpoint['success'] != true) return checkpoint;
    return filesystem.write(relativePath, checkpoint['contents']?.toString() ?? '', overwrite: true);
  }

  static bool _isIgnored(String relative) =>
      relative.startsWith('.maya_checkpoints/') || relative.startsWith('.git/') ||
      relative.contains('/build/') || relative.contains('/.dart_tool/');

  static bool _isTextFile(String relative) => const {
        'dart', 'kt', 'java', 'py', 'js', 'ts', 'json', 'yaml', 'yml', 'md', 'txt', 'xml', 'gradle',
      }.contains(relative.split('.').last.toLowerCase());
}
