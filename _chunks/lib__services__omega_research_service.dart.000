import 'dart:convert';
import 'dart:math' as math;

import 'package:http/http.dart' as http;

class MayaOmegaSourceRecord {
  final String url, title, text, sourceType, confidence;
  final DateTime fetchedAt;
  const MayaOmegaSourceRecord({required this.url, required this.title, required this.text, required this.sourceType, required this.confidence, required this.fetchedAt});
  Map<String, dynamic> toJson() => {'url': url, 'title': title, 'excerpt': text.length > 1200 ? text.substring(0, 1200) : text, 'sourceType': sourceType, 'confidence': confidence, 'fetchedAt': fetchedAt.toUtc().toIso8601String()};
}

class MayaOmegaResearchService {
  final http.Client _client;
  MayaOmegaResearchService({http.Client? client}) : _client = client ?? http.Client();

  Future<Map<String, dynamic>> buildReport({required String question, required List<String> sourceUrls}) async {
    final cleanQuestion = question.trim();
    if (cleanQuestion.isEmpty) return {'success': false, 'error': 'Research question is empty.'};
    final urls = sourceUrls.map((u) => u.trim()).where((u) => u.startsWith('https://')).take(5).toList();
    if (urls.isEmpty) return {'success': false, 'error': 'Provide at least one HTTPS source URL. Search-provider discovery is not configured.'};
    final sources = <MayaOmegaSourceRecord>[];
    final errors = <String>[];
    for (final url in urls) {
      final result = await loadSource(url);
      if (result['success'] == true && result['source'] is Map) {
        sources.add(MayaOmegaSourceRecord(url: url, title: result['source']['title']?.toString() ?? url, text: result['source']['text']?.toString() ?? '', sourceType: result['source']['sourceType']?.toString() ?? 'web', confidence: result['source']['confidence']?.toString() ?? 'supported', fetchedAt: DateTime.now().toUtc()));
      } else { errors.add('$url: ${result['error'] ?? 'source unavailable'}'); }
    }
    if (sources.isEmpty) return {'success': false, 'error': 'No source could be loaded.', 'errors': errors};
    final terms = cleanQuestion.toLowerCase().split(RegExp(r'\s+')).where((term) => term.length > 2).toSet();
    final evidence = sources.map((source) {
      final sentences = _sentences(source.text);
      final ranked = sentences.map((sentence) => MapEntry(sentence, terms.where((term) => sentence.toLowerCase().contains(term)).length)).toList()..sort((a, b) => b.value.compareTo(a.value));
      return {'url': source.url, 'title': source.title, 'confidence': source.confidence, 'excerpts': ranked.where((e) => e.value > 0).take(5).map((e) => e.key).toList()};
    }).toList();
    return {'success': true, 'question': cleanQuestion, 'sourceCount': sources.length, 'evidence': evidence, 'citations': sources.map((s) => s.url).toList(), if (errors.isNotEmpty) 'errors': errors, 'limitations': ['This report extracts evidence from the provided URLs only.', 'It does not claim that source agreement proves truth.', 'A search provider and deeper contradiction engine remain configurable adapters.']};
  }

  Future<Map<String, dynamic>> loadSource(String url) async {
    final parsed = Uri.tryParse(url);
    if (parsed == null || parsed.scheme != 'https' || parsed.host.isEmpty) return {'success': false, 'error': 'Only valid HTTPS URLs are allowed.'};
    try {
      final response = await _client.get(parsed, headers: {'Accept': 'text/html, text/plain'}).timeout(const Duration(seconds: 15));
      if (response.statusCode < 200 || response.statusCode >= 300) return {'success': false, 'error': 'HTTP ${response.statusCode}'};
      final bytes = response.bodyBytes;
      if (bytes.length > 2 * 1024 * 1024) return {'success': false, 'error': 'Source exceeds the 2 MB safety limit.'};
      final body = utf8.decode(bytes, allowMalformed: true);
      final text = _stripMarkup(body);
      if (text.trim().isEmpty) return {'success': false, 'error': 'Source contained no readable text.'};
      return {'success': true, 'source': {'url': url, 'title': _extractTitle(body) ?? parsed.host, 'text': text.substring(0, math.min(text.length, 60000)), 'sourceType': 'web', 'confidence': 'supported'}};
    } catch (error) { return {'success': false, 'error': error.toString()}; }
  }

  static String _stripMarkup(String value) => value.replaceAll(RegExp(r'<script[\s\S]*?</script>', caseSensitive: false), ' ').replaceAll(RegExp(r'<style[\s\S]*?</style>', caseSensitive: false), ' ').replaceAll(RegExp(r'<[^>]+>'), ' ').replaceAll(RegExp(r'&nbsp;|&#160;'), ' ').replaceAll(RegExp(r'&amp;'), '&').replaceAll(RegExp(r'&lt;'), '<').replaceAll(RegExp(r'&gt;'), '>').replaceAll(RegExp(r'\s+'), ' ').trim();
  static String? _extractTitle(String value) { final match = RegExp(r'<title[^>]*>([\s\S]*?)</title>', caseSensitive: false).firstMatch(value); final title = match == null ? '' : _stripMarkup(match.group(1) ?? ''); return title.isEmpty ? null : title; }
  static List<String> _sentences(String value) => value.split(RegExp(r'(?<=[.!?])\s+')).map((s) => s.trim()).where((s) => s.length > 25).toList();
  void dispose() => _client.close();
}
