import 'dart:async';
import 'dart:math' as math;
import 'package:flutter/foundation.dart';

enum EmotionDimension { valence, arousal, dominance }

class EmotionVector {
  final double valence, arousal, dominance;
  final String primaryLabel;
  final double confidence;
  final DateTime detectedAt;
  const EmotionVector({required this.valence, required this.arousal, required this.dominance, required this.primaryLabel, required this.confidence, required this.detectedAt});
  String get emoji { if (valence > 0.5 && arousal > 0.3) return '😄'; if (valence > 0.5 && arousal < 0) return '😌'; if (valence < -0.4 && arousal > 0.3) return '😤'; if (valence < -0.4 && arousal < -0.1) return '😔'; if (arousal > 0.6) return '⚡'; if (arousal < -0.5) return '😴'; return '😐'; }
  Map<String, dynamic> toJson() => {'valence': valence, 'arousal': arousal, 'dominance': dominance, 'label': primaryLabel, 'confidence': confidence, 'detectedAt': detectedAt.toIso8601String()};
}

class PersonaResponse {
  final double tone, warmth, verbosity, creativity, speechRate;
  final String voiceStyle;
  const PersonaResponse({required this.tone, required this.warmth, required this.verbosity, required this.creativity, required this.voiceStyle, required this.speechRate});
}

class EmotionEngineService extends ChangeNotifier {
  static final EmotionEngineService _instance = EmotionEngineService._();
  factory EmotionEngineService() => _instance;
  EmotionEngineService._();

  final List<EmotionVector> _emotionHistory = [];
  EmotionVector? _currentEmotion;
  PersonaResponse _currentPersona = const PersonaResponse(tone: 0.5, warmth: 0.7, verbosity: 0.5, creativity: 0.4, voiceStyle: 'calm', speechRate: 1.0);

  EmotionVector? get currentEmotion => _currentEmotion;
  PersonaResponse get currentPersona => _currentPersona;
  List<EmotionVector> get emotionHistory => List.unmodifiable(_emotionHistory);

  EmotionVector analyseText(String text) {
    final lower = text.toLowerCase();
    double valence = 0.0, arousal = 0.0, dominance = 0.0;
    const positiveWords = ['great','love','amazing','excellent','happy','wonderful','perfect','good','thanks','awesome','brilliant','fantastic'];
    const negativeWords = ['bad','hate','terrible','awful','wrong','broken','error','fail','stupid','worst','annoying','useless','frustrated'];
    for (final w in positiveWords) if (lower.contains(w)) valence += 0.15;
    for (final w in negativeWords) if (lower.contains(w)) valence -= 0.18;
    const highArousal = ['!','urgent','now','immediately','asap','quickly','help','panic','emergency'];
    const lowArousal = ['slowly','whenever','no rush','relax','calm','please take your time'];
    for (final w in highArousal) if (lower.contains(w)) arousal += 0.2;
    for (final w in lowArousal) if (lower.contains(w)) arousal -= 0.15;
    if (text.contains('!')) arousal += 0.1;
    if (text.contains('!!!')) arousal += 0.2;
    if (text == text.toUpperCase() && text.length > 4) arousal += 0.3;
    if (lower.startsWith('do ') || lower.startsWith('make ') || lower.startsWith('fix ')) dominance += 0.2;
    if (lower.contains('please') || lower.contains('could you') || lower.contains('would you')) dominance -= 0.1;
    valence = valence.clamp(-1.0, 1.0); arousal = arousal.clamp(-1.0, 1.0); dominance = dominance.clamp(-1.0, 1.0);
    final label = _label(valence, arousal);
    final confidence = math.min(0.95, 0.5 + (valence.abs() + arousal.abs()) * 0.25);
    final emotion = EmotionVector(valence: valence, arousal: arousal, dominance: dominance, primaryLabel: label, confidence: confidence, detectedAt: DateTime.now());
    _updateState(emotion); return emotion;
  }

  void analyseAudioPattern(List<double> amplitudes) {
    if (amplitudes.isEmpty) return;
    final avg = amplitudes.fold(0.0, (a, b) => a + b) / amplitudes.length;
    final peak = amplitudes.reduce(math.max);
    final variance = amplitudes.map((a) => math.pow(a - avg, 2)).fold(0.0, (a, b) => a + b) / amplitudes.length;
    final arousal = ((peak * 0.6 + math.sqrt(variance) * 0.4) * 2 - 1).clamp(-1.0, 1.0);
    final valence = _currentEmotion?.valence ?? 0.0;
    final emotion = EmotionVector(valence: valence, arousal: arousal, dominance: _currentEmotion?.dominance ?? 0.0, primaryLabel: _label(valence, arousal), confidence: 0.65, detectedAt: DateTime.now());
    _updateState(emotion);
  }

  void _updateState(EmotionVector emotion) { _currentEmotion = emotion; _emotionHistory.add(emotion); if (_emotionHistory.length > 100) _emotionHistory.removeAt(0); _currentPersona = _adaptPersona(emotion); notifyListeners(); }

  PersonaResponse _adaptPersona(EmotionVector emotion) {
    final warmth = (0.6 + emotion.valence * 0.25 + (1 - emotion.arousal.abs()) * 0.1).clamp(0.3, 1.0);
    final verbosity = emotion.arousal < 0 ? 0.75 : emotion.arousal > 0.5 ? 0.30 : 0.55;
    final tone = emotion.valence < -0.3 ? 0.25 : 0.65;
    final creativity = emotion.valence > 0.3 ? 0.65 : 0.35;
    final voiceStyle = emotion.valence < -0.4 ? 'empathetic' : emotion.arousal > 0.5 ? 'energetic' : emotion.arousal < -0.3 ? 'calm' : 'analytical';
    final speechRate = emotion.arousal > 0.5 ? 1.15 : emotion.arousal < -0.4 ? 0.88 : 1.0;
    return PersonaResponse(tone: tone, warmth: warmth, verbosity: verbosity, creativity: creativity, voiceStyle: voiceStyle, speechRate: speechRate);
  }

  String _label(double valence, double arousal) {
    if (valence > 0.4 && arousal > 0.3) return 'excited';
    if (valence > 0.4 && arousal < -0.2) return 'content';
    if (valence > 0.1) return 'happy';
    if (valence < -0.4 && arousal > 0.4) return 'angry';
    if (valence < -0.4 && arousal < -0.2) return 'sad';
    if (valence < -0.1 && arousal > 0.2) return 'frustrated';
    if (arousal > 0.5) return 'aroused';
    if (arousal < -0.4) return 'bored';
    return 'neutral';
  }

  EmotionVector? smoothedEmotion(int windowSize) {
    if (_emotionHistory.isEmpty) return null;
    final window = _emotionHistory.takeLast(math.min(windowSize, _emotionHistory.length));
    final avgV = window.map((e) => e.valence).fold(0.0, (a, b) => a + b) / window.length;
    final avgA = window.map((e) => e.arousal).fold(0.0, (a, b) => a + b) / window.length;
    final avgD = window.map((e) => e.dominance).fold(0.0, (a, b) => a + b) / window.length;
    return EmotionVector(valence: avgV, arousal: avgA, dominance: avgD, primaryLabel: _label(avgV, avgA), confidence: 0.8, detectedAt: DateTime.now());
  }

  void reset() { _emotionHistory.clear(); _currentEmotion = null; notifyListeners(); }
}

extension ListTakeLastEmotion<T> on List<T> {
  List<T> takeLast(int n) => length <= n ? this : sublist(length - n);
}
