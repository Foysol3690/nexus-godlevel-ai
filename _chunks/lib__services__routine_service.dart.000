import 'dart:convert';

import 'package:flutter_secure_storage/flutter_secure_storage.dart';

typedef MayaRoutineToolRunner = Future<Map<String, dynamic>> Function(String tool, Map<String, dynamic> arguments);

class MayaRoutine {
  final String id, name;
  final List<Map<String, dynamic>> steps;
  const MayaRoutine({required this.id, required this.name, required this.steps});
  Map<String, dynamic> toJson() => {'id': id, 'name': name, 'steps': steps};
  static MayaRoutine fromJson(Map<String, dynamic> json) => MayaRoutine(
    id: json['id']?.toString() ?? '', name: json['name']?.toString() ?? 'Routine',
    steps: (json['steps'] as List? ?? const []).whereType<Map>().map((step) => step.map((key, value) => MapEntry(key.toString(), value))).toList());
}

class RoutineService {
  static const _storage = FlutterSecureStorage();
  static const _key = 'maya_v6_routines';
  static const _allowedTools = <String>{
    'set_flashlight','set_brightness','send_notification','open_app','open_play_store','open_url','search_web','play_youtube',
    'prepare_whatsapp_message','confirm_whatsapp_message','cancel_whatsapp_message','prepare_whatsapp_call','confirm_whatsapp_call',
    'cancel_whatsapp_call','prepare_cellular_call','confirm_cellular_call','cancel_cellular_call','prepare_whatsapp_gallery_share',
    'confirm_whatsapp_gallery_share','cancel_whatsapp_gallery_share','open_hotspot_settings','set_volume','adjust_volume',
    'set_ringer_mode','lock_screen','request_secure_unlock','open_camera_vision','read_screen','click_text','type_text',
    'confirm_sensitive_text','tap','swipe','answer_call','reject_call','remember','recent_notifications','schedule_reminder','cancel_reminder',
  };

  Future<List<MayaRoutine>> list() async {
    final raw = await _storage.read(key: _key);
    if (raw == null || raw.isEmpty) return [];
    try {
      final decoded = jsonDecode(raw);
      if (decoded is! List) return [];
      return decoded.whereType<Map>().map((item) => MayaRoutine.fromJson(item.map((key, value) => MapEntry(key.toString(), value)))).toList();
    } catch (_) { return []; }
  }

  Future<void> save(MayaRoutine routine) async {
    final items = await list();
    items.removeWhere((item) => item.id == routine.id);
    items.add(routine);
    await _storage.write(key: _key, value: jsonEncode(items.map((item) => item.toJson()).toList()));
  }

  Future<void> delete(String id) async {
    final items = await list();
    items.removeWhere((item) => item.id == id);
    await _storage.write(key: _key, value: jsonEncode(items.map((item) => item.toJson()).toList()));
  }

  Future<Map<String, dynamic>> createFromToolSteps({required String name, required List<dynamic> rawSteps}) async {
    final cleanName = name.trim();
    if (cleanName.isEmpty || rawSteps.isEmpty || rawSteps.length > 20) return {'success': false, 'error': 'Routine needs a name and 1–20 steps'};
    final steps = <Map<String, dynamic>>[];
    for (final raw in rawSteps) {
      if (raw is! Map || raw['tool'] == null) return {'success': false, 'error': 'Every routine step needs a tool'};
      final tool = raw['tool'].toString().trim();
      if (!_allowedTools.contains(tool)) return {'success': false, 'error': 'Unsupported routine tool: $tool'};
      final args = raw['arguments'];
      steps.add({'tool': tool, 'arguments': args is Map ? args.map((key, value) => MapEntry(key.toString(), value)) : <String, dynamic>{}});
    }
    final id = DateTime.now().microsecondsSinceEpoch.toString();
    await save(MayaRoutine(id: id, name: cleanName, steps: steps));
    return {'success': true, 'routineId': id, 'name': cleanName, 'stepCount': steps.length};
  }

  Future<Map<String, dynamic>> summaries() async {
    final routines = await list();
    return {'success': true, 'routines': routines.map((item) => {'id': item.id, 'name': item.name, 'stepCount': item.steps.length}).toList()};
  }

  Future<Map<String, dynamic>> execute({required String id, required bool confirmed, required MayaRoutineToolRunner toolRunner}) async {
    final routines = await list();
    final matches = routines.where((item) => item.id == id).toList();
    if (matches.isEmpty) return {'success': false, 'error': 'Routine not found'};
    final routine = matches.first;
    const sensitive = {'lock_screen','request_secure_unlock','confirm_whatsapp_message','confirm_whatsapp_call','confirm_cellular_call','confirm_whatsapp_gallery_share','open_play_store','type_text'};
    if (!confirmed && routine.steps.any((step) => sensitive.contains(step['tool'])))
      return {'success': false, 'confirmationRequired': true, 'message': 'This routine contains a sensitive action. Ask for immediate confirmation.'};
    final outcomes = <Map<String, dynamic>>[];
    for (var index = 0; index < routine.steps.length; index++) {
      final step = routine.steps[index];
      final tool = step['tool']?.toString() ?? '';
      if (tool.startsWith('run_') || tool.startsWith('create_')) return {'success': false, 'error': 'Nested routine or plan execution is blocked'};
      final rawArgs = step['arguments'];
      final args = rawArgs is Map ? rawArgs.map((key, value) => MapEntry(key.toString(), value)) : <String, dynamic>{};
      Map<String, dynamic> result = <String, dynamic>{};
      for (var attempt = 1; attempt <= 2; attempt++) {
        try { result = await toolRunner(tool, args); } catch (error) { result = {'success': false, 'error': error.toString()}; }
        if (result['success'] == true || result['confirmationRequired'] == true) break;
      }
      outcomes.add({'step': index + 1, 'tool': tool, ...result});
      if (result['success'] != true) return {'success': false, 'routineId': id, 'failedStep': index + 1, 'outcomes': outcomes};
    }
    return {'success': true, 'routineId': id, 'outcomes': outcomes};
  }
}
